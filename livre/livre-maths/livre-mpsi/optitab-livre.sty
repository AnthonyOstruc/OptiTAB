\newcommand{\otRenvoi}[2]{% #1 libellé, #2 étiquette
  \ifcsname r@#2\endcsname\hyperref[#2]{#1~p.~\pageref*{#2}}\fi}

% \begin{exercice}[difficulté]{titre}
% (l'étiquette est posée après l'en-tête, pour que la page référencée soit
%  celle où l'exercice apparaît réellement, même après un saut de page)
\NewDocumentEnvironment{exercice}{O{1} m}{%
  \refstepcounter{exo}%
  \immediate\write\@auxout{\string\otChapExos{\otChapNum}{\theexo}}%
  \otEntete{otNavy}{\theexo}{#2}{#1}{\otRenvoi{Corrigé}{cor-\otChapNum-\theexo}}%
  \begin{otCorps}\label{exo-\otChapNum-\theexo}}{\end{otCorps}}

% \begin{corrige}{numéro}{titre}
\NewDocumentEnvironment{corrige}{m m}{%
  \phantomsection
  \otEntete{otGreen}{#1}{#2}{0}{\otRenvoi{Énoncé}{exo-\otChapNum-#1}}%
  \begin{otCorps}\label{cor-\otChapNum-#1}}{\end{otCorps}}

% Suite d'un long corrigé dans un nouveau bloc (même retrait, sans en-tête)
