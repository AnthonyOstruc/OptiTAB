%% ---------------------------------------------------------------------
%%  Ouverture d'unité : \unite{n}{titre anglais}{sous-titre}{illustration}
%% ---------------------------------------------------------------------
\newsavebox{\otBoiteTitre}
% Titre d'ouverture : il ne doit pas déborder sous les personnages (largeur \otLargeurTitre).
% Sur une ligne : 50 pt si possible ; titre coupé à la main ([ligne 1\\ligne 2]) : 42 pt au plus ;
% la taille diminue ensuite jusqu'à ce que le titre tienne.
\newlength{\otLargeurTitre}\setlength{\otLargeurTitre}{105mm}
\newcommand{\otMesureTitre}[3]{%
  \sbox{\otBoiteTitre}{\color{white}\otBold\fontsize{#1}{#2}\selectfont
    \foreignlanguage{english}{\begin{tabular}[b]{@{}l@{}}#3\end{tabular}}}}
\newcommand{\otTitreAjuste}[2]{% coupé (true/false), titre
  \ifthenelse{\boolean{#1}}{\otMesureTitre{42}{44}{#2}}{\otMesureTitre{50}{54}{#2}%
    \ifdim\wd\otBoiteTitre>\otLargeurTitre\otMesureTitre{42}{44}{#2}\fi}%
  \ifdim\wd\otBoiteTitre>\otLargeurTitre\otMesureTitre{38}{40}{#2}\fi
  \ifdim\wd\otBoiteTitre>\otLargeurTitre\otMesureTitre{34}{36}{#2}\fi
  \ifdim\wd\otBoiteTitre>\otLargeurTitre\otMesureTitre{30}{32}{#2}\fi
  \ifdim\ht\otBoiteTitre>20mm\def\otTitreY{41mm}\else\def\otTitreY{45mm}\fi}
\NewDocumentCommand{\unite}{o m m m m}{% [titre coupé pour l'ouverture], n, titre, sous-titre, illustration
  \otPageDroite
  \gdef\otUniteNum{#2}\gdef\otUniteTitre{#3}\gdef\otUniteSousTitre{#4}\gdef\otPref{u#2}%
  \setcounter{otrub}{0}\setcounter{otex}{0}%
  \pagestyle{otUnite}\thispagestyle{otOuverture}%
  \markright{\otUniteSousTitre}%
  \phantomsection\label{unite-#2}%
  \pdfbookmark[1]{Unit #2 — #3}{bm-unite-#2}%
  \immediate\write\@auxout{\string\otUniteVue{#2}}%
  \IfNoValueTF{#1}{\otTitreAjuste{false}{#3}}{\otTitreAjuste{true}{#1}}%
  \begin{tikzpicture}[remember picture,overlay]
    \begin{scope}[shift={([yshift=-92mm]current page.north west)}]
      \fill[otNavy] (0,0) rectangle (210mm,92mm);
      \begin{scope}[yshift=-8mm]\clip (0,8mm) rectangle (210mm,100mm);
