%% ---------------------------------------------------------------------
%%  Schéma de stratégie : \strategie{titre}{{situation}/{démarche},...}
%% ---------------------------------------------------------------------
\tikzset{
  otStratCond/.style={fill=otNavyTint,draw=otNavy!25,line width=0.4pt,rounded corners=1.2mm,
    inner xsep=2.4mm,inner ysep=1.8mm,text width=48mm,minimum height=10.5mm,align=left,
    font=\fontsize{9.2}{11.2}\selectfont},
  otStratAct/.style={fill=otGreenTint,draw=otGreen!45,line width=0.4pt,rounded corners=1.2mm,
    inner xsep=2.4mm,inner ysep=1.8mm,minimum height=10.5mm,align=left,
    font=\fontsize{9.2}{11.2}\selectfont}}
\newcommand{\strategie}[2]{%
  \par\addvspace{3mm}\needspace{20\baselineskip}\noindent
  \begin{tikzpicture}
    \node[anchor=north west,fill=\otPartieCouleur,rounded corners=1.3mm,inner xsep=3mm,inner ysep=2mm,
      text width={\linewidth-6mm},text=white,font=\otSemi\fontsize{9.5}{11}\selectfont] (titre) at (0,0)
      {\otEtiquette{otGreen}{Stratégie}\hspace{2mm}#1};
    \coordinate (bas) at (titre.south west);
    \foreach \c/\a [count=\i] in {#2}{%
      \path let \p1=(bas) in coordinate (haut) at (0,{\y1-2mm});
      \node[otStratCond,anchor=north west] (c\i) at ([xshift=0.3mm]haut) {\c};
      \node[otStratAct,anchor=north west,text width={\linewidth-52.8mm-14mm-4.8mm-0.8mm}] (a\i)
        at ([xshift=14mm]c\i.north east) {\a};
      \draw[otGreenDark,line width=0.7pt,-{Stealth[length=2mm]}]
        ([xshift=1.5mm]c\i.east) -- ([xshift=-1.5mm]c\i.east -| a\i.west);
      \path let \p1=(c\i.south), \p2=(a\i.south) in coordinate (bas) at (0,{min(\y1,\y2)});}
  \end{tikzpicture}\par\addvspace{2mm}}

