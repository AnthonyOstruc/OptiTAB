\newcommand{\otPageTitre}[2]{%
  \noindent{\otLight\fontsize{28}{32}\selectfont\color{otInk}#1}\par\vspace{2mm}
  \if\relax\detokenize{#2}\relax\else
    \noindent{\otRegular\fontsize{10}{13}\selectfont\color{otMuted}#2}\par\vspace{2mm}\fi
  \noindent{\color{otNavy}\rule{16mm}{1.3pt}}%
  {\color{otRule}\rule[0.45pt]{\dimexpr\linewidth-16mm\relax}{0.4pt}}\par\vspace{7mm}}

% Plan de la collection (sommaire) : \otPlanPartie{nom}{couleur} et \otPlanFiche{n}{titre}
\newcommand{\otPlanPartie}[2]{%
  \par\addvspace{5mm}\noindent
  {\otSemi\fontsize{7}{9}\selectfont\color{#2}\otCaps[12]{#1}}\par
  \vspace{1.2mm}{\color{#2}\hrule height 0.6pt}\vspace{1.8mm}}
\newcommand{\otPlanFiche}[2]{%
  \par\noindent\makebox[10mm][l]{{\otSemi\fontsize{9}{11}\selectfont\color{otNavy}\otTwoDigits{#1}}}%
  \ifcsname otFicheVue@#1\endcsname
    \hyperref[fiche-#1]{{\otRegular\fontsize{9.4}{12}\selectfont\color{otInk}#2}}%
    {\color{otMuted!45}\leaders\hbox to 2.4mm{\hss.\hss}\hskip 0pt plus 1fill}
    {\otMedium\fontsize{9}{11}\selectfont\color{otNavy}\pageref{fiche-#1}}%
  \else
    {\otRegular\fontsize{9.4}{12}\selectfont\color{otMuted}#2}\hfill
    {\otLight\fontsize{7.5}{9}\selectfont\color{otMuted}à paraître}%
  \fi\par\vspace{1.5mm}}

\endinput
