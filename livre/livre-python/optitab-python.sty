      \node[anchor=north west,inner xsep=3.6mm,inner ysep=2.6mm,text width=#3-7.2mm,fill=white,
        rounded corners=1.6mm,font=\otPoliceCode] (corps) at (0,-6mm) {\otMonoSetup#5\par};
      \fill[otCodeTitre,rounded corners=1.6mm] (corps.north west) rectangle ([yshift=6mm]corps.north east);
      \fill[otCodeTitre] ([yshift=-1mm]corps.north west) rectangle ([yshift=2mm]corps.north east);
      \foreach \k/\c in {0/otRed,1/otOrange,2/otGreen}{\fill[\c] ([xshift={3.6mm+\k*3.4mm},yshift=3mm]corps.north west) circle (1mm);}
      \node[anchor=center,font=\otSemi\fontsize{7.4}{8}\selectfont,text=otMuted] at ([yshift=3mm]corps.north) {#4};
