  {\end{tcolorbox}}
\NewDocumentEnvironment{experience}{o}{%
  \begin{tcolorbox}[otEncadre,colback=white,colframe=otGreen!70,boxrule=0.5pt,
    arc=1.8mm,rounded corners]
  \otEtiq{otGreenDark}{Activité expérimentale}\otNomEncadre{#1}\par\vspace{1.4mm}}
  {\end{tcolorbox}}
\NewDocumentEnvironment{rediger}{o}{%
  \begin{tcolorbox}[otEncadre,colback=otNavyTint,borderline west={1.3mm}{0pt}{otNavy!55}]
  \otEtiq{otNavy}{Bien rédiger}\otNomEncadre{#1}\par\vspace{1.4mm}}
  {\end{tcolorbox}}

%% ---------------------------------------------------------------------
%%  Éléments des énoncés : données, documents, prise d'initiative
%% ---------------------------------------------------------------------
% Données numériques d'un exercice
\NewDocumentEnvironment{donnees}{}{%
  \begin{tcolorbox}[enhanced,colback=white,colframe=otRule,boxrule=0.4pt,arc=1.6mm,
    left=3mm,right=3mm,top=1.6mm,bottom=1.6mm,otAvantColle=1.8mm,after skip=1.6mm,
    fontupper=\fontsize{9.5}{12.5}\selectfont]
  {\otSemi\fontsize{6.8}{9}\selectfont\color{otMuted}\otCaps[10]{Données}}\enspace}
  {\end{tcolorbox}}
% Document d'un problème : \begin{docu}{1}{titre} ... \source{...} \end{docu}
\NewDocumentEnvironment{docu}{m m}{%
  \begin{tcolorbox}[enhanced,colback=otNavyTint,colframe=otNavyTint,boxrule=0pt,arc=1.6mm,
    left=3.5mm,right=3.5mm,top=2mm,bottom=2mm,otAvantColle=1.8mm,after skip=1.8mm,
    fontupper=\fontsize{9.8}{13}\selectfont]
  {\otSemi\fontsize{7}{9}\selectfont\color{otNavy}\otCaps[12]{Document #1}}%
  \enspace{\otMedium\fontsize{9}{11}\selectfont\color{otInk}#2}\par\vspace{1mm}}
  {\end{tcolorbox}}
\newcommand{\source}[1]{\par\vspace{0.6mm}{\otLight\fontsize{7.2}{9}\selectfont\color{otMuted}#1}}
% Question avec prise d'initiative (épreuve écrite)
\newcommand{\initiative}{\leavevmode\tikz[baseline=(t.base)]\node[fill=otOrange!16,
  rounded corners=1.2pt,inner xsep=1.4mm,inner ysep=0.7mm,text=otOrange!70!black,
  font=\otSemi\fontsize{6.2}{7}\selectfont](t){\otCaps[8]{Prise d'initiative}};\enspace}
% Repère de capacité numérique ou expérimentale dans un énoncé
\newcommand{\capacite}[1]{\leavevmode\tikz[baseline=(t.base)]\node[fill=otGreenTint,
  rounded corners=1.2pt,inner xsep=1.4mm,inner ysep=0.7mm,text=otGreenDark,
  font=\otSemi\fontsize{6.2}{7}\selectfont](t){\otCaps[8]{#1}};\enspace}

%% ---------------------------------------------------------------------
%%  Figures : une source pour l'énoncé et le corrigé
%%  \schema{nom} (énoncé) ou \schema[corrige]{nom} ; dans le fichier
%%  figures/nom.tex, \solution{...} n'apparaît qu'au corrigé.
%% ---------------------------------------------------------------------
\newif\ifpcCorrige
\newcommand{\solution}[1]{\ifpcCorrige #1\fi}
\newcommand{\enonce}[1]{\ifpcCorrige\else #1\fi}
\NewDocumentCommand{\schema}{O{enonce} m}{%
  \par\nopagebreak\vspace{2mm}%
  \begingroup
  \ifstrequal{#1}{corrige}{\pcCorrigetrue}{\pcCorrigefalse}%
  \noindent\begin{minipage}{\linewidth}%
  \centering\input{figures/#2.tex}\par
  \end{minipage}\par
  \endgroup\vspace{1mm}}
% Texte et figure côte à côte (corrigés compacts) : \schemaCote{nom}[fraction]{texte}
\newlength{\pcCoteL}
\NewDocumentCommand{\schemaCote}{O{corrige} m O{0.4} +m}{%
  \par\vspace{1mm}\setlength{\pcCoteL}{#3\linewidth}%
  \noindent\begin{minipage}[t]{\dimexpr\linewidth-\pcCoteL-4mm\relax}\vspace{0pt}\raggedright#4\end{minipage}\hfill
  \begin{minipage}[t]{\pcCoteL}\vspace{0pt}\begingroup
  \ifstrequal{#1}{corrige}{\pcCorrigetrue}{\pcCorrigefalse}%
  \centering\input{figures/#2.tex}\par\endgroup\end{minipage}\par\vspace{1mm}}
\newcommand{\demarche}[1]{%
  \par{\otLight\fontsize{9}{12}\selectfont\color{otMuted}#1}\par\vspace{1.4mm}}
% Notes pédagogiques des corrigés : \retiens{...} (À retenir) et \piege{...} (Erreur fréquente)
\newcommand{\pcNoteCorrige}[3]{%
  \par\vspace{1.2mm}%
  \begin{tcolorbox}[enhanced,frame hidden,colback=#1!7,borderline west={1.1pt}{0pt}{#1},boxrule=0pt,arc=0pt,
    left=2.2mm,right=2mm,top=0.9mm,bottom=0.9mm,before skip=0pt,after skip=0pt]
  {\otSemi\fontsize{6.4}{8}\selectfont\color{#1}\otCaps[8]{#2}}\enspace{\fontsize{9.5}{12.5}\selectfont#3}%
  \end{tcolorbox}\par}
\newcommand{\retiens}[1]{\pcNoteCorrige{otGreenDark}{À retenir}{#1}}
\newcommand{\piege}[1]{\pcNoteCorrige{otOrange!75!black}{Erreur fréquente}{#1}}

% Bloc insécable contrôlé (énoncé ou corrigé avec ses figures)
\newsavebox{\otBlocLivreBox}
\newenvironment{blocLivre}[1]{%
  \def\otBlocLivreId{#1}%
  \par\addvspace{4mm}\noindent
  \begin{lrbox}{\otBlocLivreBox}\begin{minipage}{\linewidth}%
}{%
  \end{minipage}\end{lrbox}%
  \ifdim\dimexpr\ht\otBlocLivreBox+\dp\otBlocLivreBox\relax>\textheight
    \PackageError{pc-livre}{Bloc trop haut : \otBlocLivreId}{Repartir son contenu.}%
  \fi
  \typeout{OTBLOC|\otBlocLivreId|\the\dimexpr\ht\otBlocLivreBox+\dp\otBlocLivreBox\relax}%
  \noindent\usebox{\otBlocLivreBox}\par}

%% ---------------------------------------------------------------------
%%  Pages des défis et compléments (une page par élément)
%% ---------------------------------------------------------------------
\newsavebox{\editionTitreBoite}
\NewDocumentCommand{\editionPage}{O{} m m m m}{%
  \clearpage\gdef\otChapNum{0}\pagestyle{otFront}\thispagestyle{otFront}#1%
  \phantomsection\label{#2}\pdfbookmark[1]{#3}{bm-#2}%
  \otPageTitre{\sbox{\editionTitreBoite}{\otLight\fontsize{27}{31}\selectfont #3}%
    \ifdim\wd\editionTitreBoite>\linewidth\resizebox{\linewidth}{!}{\usebox{\editionTitreBoite}}%
    \else\usebox{\editionTitreBoite}\fi}{#4}%
  {\otMedium\fontsize{9}{12}\selectfont\color{otMuted}#5}\par\vspace{4mm}%
  \fontsize{11}{15}\selectfont}
\newsavebox{\editionBoite}
\newenvironment{blocEdition}[1]{%
  \def\editionBlocId{#1}%
  \noindent\begin{lrbox}{\editionBoite}\begin{minipage}{\linewidth}%
}{%
  \end{minipage}\end{lrbox}%
  \ifdim\dimexpr\ht\editionBoite+\dp\editionBoite\relax>560pt
    \PackageError{pc-livre}{Page trop chargee : \editionBlocId}{Scinder le contenu.}%
  \fi
  \typeout{OTEDITION|\editionBlocId|\the\dimexpr\ht\editionBoite+\dp\editionBoite\relax}%
  \noindent\usebox{\editionBoite}\par}
\newcommand{\editionEtape}[1]{\par\addvspace{4mm}\otIntertitre{#1}\nopagebreak}
\newcommand{\editionRetenir}[1]{%
  \par\vspace{4mm}\begin{tcolorbox}[colback=otGreenTint,colframe=otGreenTint,
    boxrule=0pt,arc=1.5mm,left=3mm,right=3mm,top=2mm,bottom=2mm]
  {\otSemi\fontsize{8}{10}\selectfont\color{otGreenDark}À RETENIR}\par\smallskip
  #1\end{tcolorbox}}
% Renvoi sûr vers une page (grisé tant que la cible n'existe pas)
\newcommand{\otLigneRessource}[2]{%
  \ifcsname r@#1\endcsname
    \hyperref[#1]{\textcolor{otNavy}{#2}}\otPoints{\otMedium p.~\pageref*{#1}}%
  \else
    {\color{otMuted!80}#2}\otPoints{\otLight\color{otMuted!60}à paraître}%
  \fi\par\vspace{3.2mm}}

%% ---------------------------------------------------------------------
%%  Verrerie et montages (schémas vectoriels)
%%  Chaque objet est un « pic » TikZ dont l'origine est au milieu du fond.
%%  \pic at (x,y) {becher={niveau=1.2,liquide=otGreen!25}};
%% ---------------------------------------------------------------------
\tikzset{
  pcVerre/.style={draw=otNavy,line width=0.7pt,line join=round,line cap=round},
  pcLiquide/.style={draw=none},
  pcSurface/.style={draw=otNavy!45,line width=0.4pt},
  pcAppareil/.style={draw=otInk!75,line width=0.6pt,fill=otRule!35,line join=round},
  pcFil/.style={draw=otInk!70,line width=0.8pt,line cap=round},
  pcRepere/.style={draw=otMuted,line width=0.4pt},
  pcLegende/.style={font=\otLight\fontsize{7.5}{9}\selectfont,text=otInk,inner sep=1.4pt,align=left},
  pcLegendeG/.style={font=\otMedium\fontsize{7.5}{9}\selectfont,text=otInk,inner sep=1.4pt,align=center},
  pcFleche/.style={draw=otGreenDark,line width=0.9pt,-{Stealth[length=2.2mm]}},
  pcFlecheN/.style={draw=otNavy,line width=0.8pt,-{Stealth[length=2mm]}}}
% Teintes des solutions : incolore, indicateurs colorés
\colorlet{pcEau}{otNavy!9}
\colorlet{pcJaune}{yellow!55!orange!45!white}
\colorlet{pcVert}{otGreen!50}
\colorlet{pcBleu}{cyan!45!otNavy!55}
\pgfkeys{/pc/.is family,/pc,
  largeur/.store in=\pcL,hauteur/.store in=\pcH,niveau/.store in=\pcN,
  liquide/.store in=\pcC,texte/.store in=\pcT,jauge/.store in=\pcJ}
\newcommand{\pcDefauts}[1]{\pgfkeys{/pc,largeur=1.6,hauteur=2,niveau=1.1,
  liquide=pcEau,texte={},jauge=1,#1}}
% Légende reliée par un filet : \pcNote[ancre]{(point)}{(texte)}{légende}
\NewDocumentCommand{\pcNote}{O{west} m m m}{%
  \draw[pcRepere] #2 -- #3 node[pcLegende,anchor=#1]{#4};}
\tikzset{
  % Bécher : largeur, hauteur, niveau, liquide
  pics/becher/.style={code={%
    \pcDefauts{#1}%
    \pgfmathsetmacro\pcl{\pcL/2}%
    \ifdim\pcN pt>0pt
      \fill[\pcC] ({-\pcl+0.05},\pcN) -- ({-\pcl+0.05},0.15) arc[start angle=180,end angle=270,radius=0.1]
        -- ({\pcl-0.15},0.05) arc[start angle=270,end angle=360,radius=0.1] -- ({\pcl-0.05},\pcN) -- cycle;
      \draw[pcSurface] ({-\pcl+0.05},\pcN) -- ({\pcl-0.05},\pcN);
    \fi
    \foreach \g in {0.42,0.6,0.78}{\draw[otNavy!40,line width=0.4pt] ({\pcl-0.3},{\g*\pcH}) -- ({\pcl-0.09},{\g*\pcH});}
    \draw[pcVerre] ({-\pcl-0.15},{\pcH+0.07}) -- ({-\pcl},{\pcH-0.1}) -- ({-\pcl},0.14)
      arc[start angle=180,end angle=270,radius=0.14] -- ({\pcl-0.14},0)
      arc[start angle=270,end angle=360,radius=0.14] -- ({\pcl},\pcH) -- ++(0.07,0.05);
    \coordinate (-haut) at (0,\pcH); \coordinate (-liquide) at (0,{\pcN/2});
    \coordinate (-droite) at ({\pcl},{0.7*\pcH}); \coordinate (-gauche) at ({-\pcl},{0.7*\pcH});}},
  pics/becher/.default={},
  % Fiole jaugée : hauteur (col compris), niveau (1 = au trait de jauge)
  pics/fiole/.style={code={%
    \pcDefauts{hauteur=3.1,niveau=1,#1}%
    \def\pcFioleContour{(-0.15,\pcH) -- (-0.15,1.62) .. controls (-0.15,1.36) and (-0.84,1.22) .. (-0.84,0.66)
      .. controls (-0.84,0.3) and (-0.7,0) .. (-0.48,0) -- (0.48,0) .. controls (0.7,0) and (0.84,0.3) .. (0.84,0.66)
      .. controls (0.84,1.22) and (0.15,1.36) .. (0.15,1.62) -- (0.15,\pcH)}%
    \pgfmathsetmacro\pcJauge{\pcH-0.75}%
    \pgfmathsetmacro\pcNiv{\pcN*\pcJauge}%
    \begin{scope}
      \clip \pcFioleContour -- cycle;
      \fill[\pcC] (-1,0) rectangle (1,\pcNiv);
    \end{scope}
    \draw[pcSurface] (-0.15,\pcNiv) -- (0.15,\pcNiv);
    \draw[pcVerre] \pcFioleContour;
    \draw[otNavy,line width=0.55pt] (-0.24,\pcJauge) -- (0.24,\pcJauge);
    \draw[pcVerre] (-0.21,\pcH) -- (0.21,\pcH);
    \coordinate (-jauge) at (0.24,\pcJauge); \coordinate (-haut) at (0,\pcH);
    \coordinate (-bulbe) at (0.84,0.66);}},
  pics/fiole/.default={},
  % Pipette jaugée : hauteur (longueur), niveau (1 = au trait de jauge, 0 = vide)
  pics/pipette/.style={code={%
    \pcDefauts{hauteur=4.3,niveau=1,#1}%
    \def\pcPipContour{(-0.015,0) -- (-0.055,0.42) -- (-0.055,1.35) .. controls (-0.055,1.5) and (-0.2,1.52) .. (-0.2,1.72)
      -- (-0.2,2.42) .. controls (-0.2,2.62) and (-0.055,2.64) .. (-0.055,2.8) -- (-0.055,\pcH)
      -- (0.055,\pcH) -- (0.055,2.8) .. controls (0.055,2.64) and (0.2,2.62) .. (0.2,2.42) -- (0.2,1.72)
      .. controls (0.2,1.52) and (0.055,1.5) .. (0.055,1.35) -- (0.055,0.42) -- (0.015,0)}%
    \pgfmathsetmacro\pcJauge{\pcH-0.55}%
    \ifdim\pcN pt>0pt
      \pgfmathsetmacro\pcNiv{\pcN*\pcJauge}%
      \begin{scope}\clip \pcPipContour -- cycle; \fill[\pcC] (-1,0) rectangle (1,\pcNiv);\end{scope}
    \fi
    \draw[pcVerre,line width=0.6pt] \pcPipContour;
    \draw[otNavy,line width=0.55pt] (-0.12,\pcJauge) -- (0.12,\pcJauge);
    \coordinate (-jauge) at (0.12,\pcJauge); \coordinate (-haut) at (0,\pcH);
    \coordinate (-bulbe) at (0.2,2.05); \coordinate (-pointe) at (0,0);}},
  pics/pipette/.default={},
  % Tube à essais : hauteur, niveau, liquide
  pics/tube/.style={code={%
    \pcDefauts{hauteur=2.3,niveau=1.1,#1}%
    \ifdim\pcN pt>0pt
