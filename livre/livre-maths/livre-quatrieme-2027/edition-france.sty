\newsavebox{\editionTitreBoite}
\NewDocumentCommand{\editionPage}{O{} m m m m}{%
  \clearpage\gdef\otChapNum{0}\pagestyle{otFront}\thispagestyle{otFront}#1%
  \phantomsection\label{#2}\pdfbookmark[1]{#3}{bm-#2}%
  \otPageTitre{\sbox{\editionTitreBoite}{\otLight\fontsize{27}{31}\selectfont #3}%
    \ifdim\wd\editionTitreBoite>\linewidth\resizebox{\linewidth}{!}{\usebox{\editionTitreBoite}}%
    \else\usebox{\editionTitreBoite}\fi}{#4}%
  {\otMedium\fontsize{9}{12}\selectfont\color{otMuted}#5}\par\vspace{4mm}%
  \fontsize{11}{15}\selectfont}
\newsavebox{\editionBoite}
\newenvironment{blocEdition}[1]{%
  \def\editionBlocId{#1}%
  \noindent\begin{lrbox}{\editionBoite}\begin{minipage}{\linewidth}%
}{%
  \end{minipage}\end{lrbox}%
  \ifdim\dimexpr\ht\editionBoite+\dp\editionBoite\relax>560pt
    \PackageError{edition-france}{Page trop chargee : \editionBlocId}{Scinder le contenu.}%
  \fi
  \typeout{OTEDITION|\editionBlocId|\the\dimexpr\ht\editionBoite+\dp\editionBoite\relax}%
  \noindent\usebox{\editionBoite}\par}
\newcommand{\editionEtape}[1]{\par\addvspace{4mm}\otIntertitre{#1}\nopagebreak}
\newcommand{\editionRetenir}[1]{%
  \par\vspace{4mm}\begin{tcolorbox}[colback=otGreenTint,colframe=otGreenTint,
    boxrule=0pt,arc=1.5mm,left=3mm,right=3mm,top=2mm,bottom=2mm]
  {\otSemi\fontsize{8}{10}\selectfont\color{otGreenDark}À RETENIR}\par\smallskip
  #1\end{tcolorbox}}
