%% ---------------------------------------------------------------------
%%  Pistes audio : identifiant « 1.02 » -> fichier « piste-1-02.mp3 »
%%  Les durées viennent de tome-N/audio/durees.tex (écrit par outils/audio.py)
%% ---------------------------------------------------------------------
\ExplSyntaxOn
\tl_new:N \l_ot_url_tl
\NewDocumentCommand{\otFixeURLPiste}{m}{
  \tl_set:Nn \l_ot_url_tl {#1}
  \tl_replace_all:Nnn \l_ot_url_tl {.} {-}
  \tl_put_left:Nx \l_ot_url_tl {\otAudioBase piste-}
  \tl_put_right:Nn \l_ot_url_tl {.mp3}
  \cs_set_eq:NN \otURLPiste \l_ot_url_tl}
\NewDocumentCommand{\otFixeURL}{m}{
  \tl_set:Nx \l_ot_url_tl {\otAudioBase #1}
  \cs_set_eq:NN \otURLPiste \l_ot_url_tl}
\ExplSyntaxOff
\newcommand{\otDuree}[2]{\expandafter\gdef\csname otDuree@#1\endcsname{#2}}
\newcommand{\otDureeDe}[1]{\ifcsname otDuree@#1\endcsname\csname otDuree@#1\endcsname\fi}
\newcommand{\otUniteAudio}[3]{% unité, nombre de pistes, durée totale
  \expandafter\gdef\csname otUnitePistes@#1\endcsname{#2}%
  \expandafter\gdef\csname otUniteDuree@#1\endcsname{#3}}
% QR code d'une piste (lien cliquable dans le PDF)
\newcommand{\otQR}[2]{% hauteur, adresse déjà fixée dans \otURLPiste
  \edef\otQRtmp{\noexpand\qrcode[height=#1,level=M]{\otURLPiste}}\otQRtmp}
% \qrpiste[taille]{1.02}{légende} : QR + numéro + durée + légende
\NewDocumentCommand{\qrpiste}{O{14mm} m m}{%
  \otFixeURLPiste{#2}%
  \ifcsname otPisteVue@#2\endcsname\else\expandafter\gdef\csname otPisteVue@#2\endcsname{}%
    \phantomsection\label{piste-#2}\fi
  \begin{tabular}[t]{@{}c@{}}%
    {\color{otInk}\otQR{#1}{#2}}\\[0.9mm]
    \otPastillePiste{#2}%
    \if\relax\detokenize{#3}\relax\else\\[0.4mm]{\otMedium\fontsize{6.4}{7.5}\selectfont\color{otMuted}#3}\fi
  \end{tabular}}
% Pastille « casque 1.02 · 0:42 »
\newcommand{\otPastillePiste}[1]{%
  \tikz[baseline=(p.base)]{\node[fill=otNavy,rounded corners=1.5mm,inner xsep=1.6mm,inner ysep=0.9mm,
    text=white,font=\otSemi\fontsize{6.6}{7.5}\selectfont] (p)
    {\hspace{3.6mm}#1%
     \ifcsname otDuree@#1\endcsname{\otLight\ \textperiodcentered\ \csname otDuree@#1\endcsname}\fi};
   \otDessinIcone{casque}{white}{otNavy}{2.8mm}{([xshift=3.1mm,yshift=0.15mm]p.west)}}}
% Mention de piste dans le texte : \piste{1.02}
\newcommand{\piste}[1]{\otPastillePiste{#1}}

