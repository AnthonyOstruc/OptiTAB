%% Données écrites dans le fichier .aux (sommaire de chapitre automatique)
\newcommand{\otRubData}[4]{%
  \expandafter\gdef\csname otRub@#1@#2\endcsname{#3}%
  \expandafter\gdef\csname otRubFirst@#1@#2\endcsname{#4}}
\newcommand{\otChapRubs}[2]{\expandafter\gdef\csname otNRub@#1\endcsname{#2}}
