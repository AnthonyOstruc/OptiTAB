% Titre interne : étiquette + intitulé facultatif
\newcommand{\otTitreBoite}[3]{% couleur, étiquette, intitulé
  \noindent\otEtiquette{#1}{#2}%
  \if\relax\detokenize{#3}\relax\else\hspace{1.6mm}{\otMedium\fontsize{8.6}{10}\selectfont\color{otInk}#3}\fi
  \par\vspace{1.1mm}}

\NewDocumentEnvironment{definition}{O{}}{%
  \begin{tcolorbox}[otBase,colback=white,colframe=otNavy,boxrule=0pt,
    borderline west={1.1mm}{0pt}{otNavy},
    overlay={\draw[otRule,line width=0.5pt,rounded corners=1.3mm]
      (frame.north west) rectangle (frame.south east);}]
  \otTitreBoite{otNavy}{Définition}{#1}}{\end{tcolorbox}}

\NewDocumentEnvironment{theoreme}{O{}}{%
  \begin{tcolorbox}[otBase,colback=otNavyTint,colframe=otNavyTint,
    borderline west={1.1mm}{0pt}{otNavy}]
  \otTitreBoite{otNavy}{Théorème}{#1}}{\end{tcolorbox}}

\NewDocumentEnvironment{propriete}{O{}}{%
  \begin{tcolorbox}[otBase,colback=otNavyTint,colframe=otNavyTint,
    borderline west={1.1mm}{0pt}{otNavy!55}]
  \otTitreBoite{otNavy}{Propriété}{#1}}{\end{tcolorbox}}

\NewDocumentEnvironment{methode}{O{}}{%
  \begin{tcolorbox}[otBase,colback=otGreenTint,colframe=otGreenTint,
    borderline west={1.1mm}{0pt}{otGreenDark}]
  \otTitreBoite{otGreenDark}{Méthode}{#1}}{\end{tcolorbox}}

\NewDocumentEnvironment{attention}{O{}}{%
