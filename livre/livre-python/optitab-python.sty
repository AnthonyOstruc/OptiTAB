      \node[anchor=north west,inner xsep=3.6mm,inner ysep=2.6mm,text width=#3-7.2mm,fill=otEcran,
        rounded corners=1.6mm,font=\otPoliceCode,text=otEcranTexte] (corps) at (0,-5.4mm) {\otMonoSetup\otThemeEcran\color{otEcranTexte}#4\par};
      \fill[otEcranTitre,rounded corners=1.6mm] (corps.north west) rectangle ([yshift=5.4mm]corps.north east);
      \fill[otEcranTitre] ([yshift=-1mm]corps.north west) rectangle ([yshift=2mm]corps.north east);
      \otDessinIcone{terminal}{otEcranMuet}{otEcranTitre}{3.2mm}{([xshift=4.6mm,yshift=2.7mm]corps.north west)}
      \node[anchor=west,font=\otSemi\fontsize{6.8}{8}\selectfont,text=otEcranMuet] at ([xshift=7.6mm,yshift=2.7mm]corps.north west) {\otCaps[10]{Output}};
    \end{tikzpicture}};}
% Mot décoratif dans les ouvertures : \otDeco{texte}{x}{y}{taille}{opacité}
