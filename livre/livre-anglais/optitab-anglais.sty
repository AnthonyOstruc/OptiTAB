\pgfkeys{/otex/.is family,/otex,
  ecouter/.code={\def\otExEcouter{1}},parler/.code={\def\otExParler{1}},
  lire/.code={\def\otExLire{1}},ecrire/.code={\def\otExEcrire{1}},
  niveau/.store in=\otExNiveau,piste/.store in=\otExPiste,points/.store in=\otExPoints}
\newcommand{\otDifficulte}[1]{%
  \tikz[baseline=-0.6ex]{\foreach \i in {1,2,3}{%
    \ifnum\i>#1\relax\draw[otNavy!45,line width=0.5pt] (\i*2.9mm,0) circle (0.95mm);
    \else\fill[otNavy] (\i*2.9mm,0) circle (1.1mm);\fi}}}
\newcommand{\otCompetence}[2]{\ifnum#1=1\relax\hspace{0.9mm}\otTuile[4.6mm]{#2}{otNavy!80}\fi}
\NewDocumentCommand{\exercice}{O{} m m}{%
  \def\otExEcouter{0}\def\otExParler{0}\def\otExLire{0}\def\otExEcrire{0}%
  \def\otExNiveau{1}\def\otExPiste{}\def\otExPoints{}%
  \pgfkeys{/otex,#1}%
  \par\addvspace{6mm}\needspace{10\baselineskip}%
  \refstepcounter{otex}%
  \def\@currentlabelname{#2}%
  \label{ex-\otPref-\theotex}%
  \noindent
  \tikz[baseline=(n.base)]\node[fill=otNavy,rounded corners=1.4mm,minimum width=7mm,minimum height=7mm,
    inner sep=0pt,text=white,font=\otBold\fontsize{10}{10}\selectfont] (n) {\theotex};%
  \hspace{2.8mm}{\otSemi\fontsize{11.6}{14}\selectfont\color{otInk}#2}%
  \hfill
  \otCompetence{\otExEcouter}{casque}\otCompetence{\otExParler}{micro}%
  \otCompetence{\otExLire}{livre}\otCompetence{\otExEcrire}{crayon}%
  \hspace{2.6mm}\otDifficulte{\otExNiveau}%
  \ifx\otExPoints\@empty\else\hspace{2.6mm}{\otSemi\fontsize{7.4}{9}\selectfont\color{otGreenDark}/\,\otExPoints~pts}\fi
  \ifcsname r@cor-\otPref-\theotex\endcsname
    \hspace{2.6mm}{\otLight\fontsize{7}{9}\selectfont\color{otMuted}corrigé p.~\pageref{cor-\otPref-\theotex}}\fi
  \par\nopagebreak\vspace{2mm}%
  \ifx\otExPiste\@empty
    \noindent{\fontsize{10.4}{13}\selectfont #3\par}%
  \else
    \noindent\begin{minipage}[c]{\dimexpr\linewidth-24mm\relax}{\fontsize{10.4}{13}\selectfont #3\par}\end{minipage}%
    \hfill\begin{minipage}[c]{22mm}\raggedleft\qrpiste[13.5mm]{\otExPiste}{}\end{minipage}\par
  \fi
  \nopagebreak\vspace{2.6mm}}
