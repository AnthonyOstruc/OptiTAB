  \draw[white,opacity=0.22,line width=0.5pt] (0,8mm) -- (210mm,8mm);
  \draw[white,opacity=0.22,line width=0.5pt] (192mm,0) -- (192mm,118mm);
  \draw[white,opacity=0.55,line width=1.6pt,line cap=round]
