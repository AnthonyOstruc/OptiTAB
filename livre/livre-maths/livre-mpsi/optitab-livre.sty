%% ---------------------------------------------------------------------
%%  Ouverture de chapitre (page entière)
%%  \begin{ouverture}[décor]{numéro}{titre}{partie}{notions}
%%    \objectif{...}  \objectif{...}
%%  \end{ouverture}
%% ---------------------------------------------------------------------
\newcounter{exo}
\newcounter{otRub}
\newcounter{otTmp}

\newcommand{\objectif}[1]{%
  \par\noindent\otCheck\hspace{3mm}%
  \parbox[t]{\dimexpr\linewidth-7mm\relax}{\raggedright#1}\par\vspace{2.6mm}}

% Prérequis (dans le corps de l'ouverture, après les objectifs)
\newif\ifotPrerequisTitre
\newcommand{\prerequis}[1]{%
  \ifotPrerequisTitre\else
    \global\otPrerequisTitretrue
    \par\vspace{7mm}\otIntertitre{Prérequis}%
  \fi
  \par\noindent\makebox[7mm][l]{\hspace{1.2mm}\tikz[baseline=-0.62ex]\fill[otNavy] (0,0) circle (0.8mm);}%
  \parbox[t]{\dimexpr\linewidth-7mm\relax}{\raggedright#1}\par\vspace{2mm}}

\newcommand{\otDansCeLigne}[1]{%
  \edef\otFirst{\csname otRubFirst@\otChapNum @#1\endcsname}%
  \ifnum#1<\csname otNRub@\otChapNum\endcsname\relax
    \edef\otLast{\the\numexpr\csname otRubFirst@\otChapNum @\the\numexpr#1+1\relax\endcsname-1\relax}%
  \else
    \edef\otLast{\csname otNExo@\otChapNum\endcsname}%
  \fi
  \par\noindent{\otSemi\fontsize{9}{11}\selectfont\color{otNavy}%
    \csname otRub@\otChapNum @#1\endcsname}%
  \hfill{\otMedium\fontsize{8.5}{11}\selectfont\color{otInk}p.~\pageref*{rub-\otChapNum-#1}}\par
  {\otLight\fontsize{7.5}{10}\selectfont\color{otMuted}%
    \ifnum\otFirst=\otLast\relax Exercice~\otFirst\else Exercices~\otFirst~à~\otLast\fi}\par
  \vspace{2.4mm}}

\newcommand{\otDansCe}{%
  \ifcsname r@ess-\otChapNum\endcsname
    \par\noindent{\otSemi\fontsize{9}{11}\selectfont\color{otNavy}L'essentiel}%
    \hfill{\otMedium\fontsize{8.5}{11}\selectfont\color{otInk}p.~\pageref*{ess-\otChapNum}}\par
    {\otLight\fontsize{7.5}{10}\selectfont\color{otMuted}Synthèse du cours et méthodes}\par
    \vspace{2.4mm}%
  \fi
  \ifcsname otNRub@\otChapNum\endcsname
    \setcounter{otTmp}{0}%
    \loop\ifnum\value{otTmp}<\csname otNRub@\otChapNum\endcsname\relax
      \stepcounter{otTmp}%
      \otDansCeLigne{\arabic{otTmp}}%
    \repeat
  \fi
  \ifcsname r@cor-\otChapNum-1\endcsname
    {\color{otRule}\rule{\linewidth}{0.4pt}}\par\vspace{2.4mm}%
    \noindent{\otSemi\fontsize{9}{11}\selectfont\color{otGreenDark}Corrigés}%
    \hfill{\otMedium\fontsize{8.5}{11}\selectfont\color{otInk}p.~\pageref*{corchap-\otChapNum}}\par
  \fi}

\newsavebox\otBoiteTitre
\NewDocumentEnvironment{ouverture}{O{courbe} m m m m +b}{%
  \otCleardoublepage
  \setcounter{chapter}{#2}\setcounter{exo}{0}\setcounter{otRub}{0}%
  \gdef\otChapNum{#2}\gdef\otChapTitle{#3}%
  \global\otCorrigesfalse\gdef\otAccent{otNavy}\global\otSouplefalse
  \global\otPrerequisTitrefalse
  \markboth{#3}{#3}%
  \thispagestyle{empty}%
  \phantomsection\label{chap-#2}%
  \pdfbookmark[0]{\otTwoDigits{#2} · #3}{bm-chap-#2}%
  \begin{tikzpicture}[remember picture,overlay]
    \begin{scope}[shift={([yshift=-118mm]current page.north west)}]
      \fill[otNavy] (0,0) rectangle (210mm,118mm);
      \begin{scope}
        \clip (0,0) rectangle (210mm,118mm);
        \ifcsname otDeco#1\endcsname\csname otDeco#1\endcsname\else\otDecocourbe\fi
      \end{scope}
      % Partie
      \node[anchor=north west,fill=otGreenDark,rounded corners=2.2mm,
        inner xsep=3.2mm,inner ysep=1.9mm,text=white,
        font=\otSemi\fontsize{7}{8}\selectfont] at (24mm,100mm) {\otCaps[16]{#4}};
      % Numéro et titre
      \node[anchor=base west,inner sep=0pt,text=white,
        font=\otThin\fontsize{112}{112}\selectfont] at (21mm,46mm) {\otTwoDigits{#2}};
      \node[anchor=base west,inner sep=0pt,text=white] at (24mm,27mm)
        {\sbox\otBoiteTitre{\otSemi\fontsize{30}{34}\selectfont #3}%
         \ifdim\wd\otBoiteTitre>166mm\resizebox{166mm}{!}{\usebox\otBoiteTitre}\else\usebox\otBoiteTitre\fi};
      \node[anchor=base west,inner sep=0pt,text=white,opacity=0.78,
        font=\otLight\fontsize{9.5}{12}\selectfont] at (24mm,15mm) {#5};
    \end{scope}
    % Objectifs
    \node[anchor=north west,inner sep=0pt,text width=94mm]
      at ([xshift=24mm,yshift=-138mm]current page.north west)
      {\otIntertitre{Objectifs du chapitre}%
       \fontsize{10.5}{13.5}\selectfont #6};
    % Dans ce chapitre
    \node[anchor=north west,fill=otNavyTint,rounded corners=2mm,
      inner sep=5mm,text width=52mm]
      at ([xshift=126mm,yshift=-136mm]current page.north west)
      {\otIntertitre{Dans ce chapitre}\otDansCe};
    % Légende des difficultés et cours en ligne
    \node[anchor=south west,inner sep=0pt]
      at ([xshift=24mm,yshift=30mm]current page.south west)
      {\otLegende};
    \node[anchor=south east,inner sep=0pt]
      at ([xshift=-22mm,yshift=40mm]current page.south east)
      {\otQRCours};
  \end{tikzpicture}%
  \clearpage}{}
\RequirePackage{etoolbox}

\newcommand{\otLegende}{%
  {\otLight\fontsize{8}{10}\selectfont\color{otMuted}%
   Niveau de difficulté\hspace{1.2em}%
   \otDots{1}\hspace{0.45em}accessible\hspace{1.4em}%
   \otDots{2}\hspace{0.45em}intermédiaire\hspace{1.4em}%
   \otDots{3}\hspace{0.45em}approfondi}}

%% ---------------------------------------------------------------------
%%  Rubriques (Découverte, Entraînement, Problèmes)
%% ---------------------------------------------------------------------
\newcommand{\rubrique}[1]{%
  \par\addvspace{8mm}\otBesoinPlace{10\baselineskip}%
  \stepcounter{otRub}%
  \immediate\write\@auxout{\string\otRubData{\otChapNum}{\theotRub}%
    {\unexpanded{#1}}{\the\numexpr\value{exo}+1\relax}}%
  \immediate\write\@auxout{\string\otChapRubs{\otChapNum}{\theotRub}}%
  \markright{#1}%
  \phantomsection\label{rub-\otChapNum-\theotRub}%
  \noindent
  \begin{tikzpicture}[baseline=(b.base)]
    \fill[otNavyTint,rounded corners=1.6mm] (0,-2.6mm) rectangle (\linewidth,6.4mm);
    \fill[otNavy] (0,-2.6mm) rectangle (1.3mm,6.4mm);
    \node[anchor=base west,inner sep=0pt,text=otNavy,
      font=\otSemi\fontsize{8.5}{10}\selectfont] (b) at (5mm,0) {\otCaps[18]{#1}};
    \node[anchor=base east,inner sep=0pt,text=otMuted,
      font=\otLight\fontsize{7.5}{10}\selectfont] at ([xshift=-4mm]\linewidth,0)
      {\otPlageRubrique};
  \end{tikzpicture}\par\nopagebreak
  \vspace{1mm}\global\otApresRubriquetrue}

\newcommand{\otPlageRubrique}{%
  \ifcsname otRubFirst@\otChapNum @\theotRub\endcsname
    \edef\otFirst{\csname otRubFirst@\otChapNum @\theotRub\endcsname}%
    \ifnum\theotRub<\csname otNRub@\otChapNum\endcsname\relax
      \edef\otLast{\the\numexpr\csname otRubFirst@\otChapNum @\the\numexpr\theotRub+1\relax\endcsname-1\relax}%
    \else
      \edef\otLast{\csname otNExo@\otChapNum\endcsname}%
    \fi
    \ifnum\otFirst=\otLast\relax Exercice~\otFirst\else Exercices~\otFirst~à~\otLast\fi
  \fi}

%% ---------------------------------------------------------------------
%%  Exercices et corrigés
%% ---------------------------------------------------------------------
\newlength{\otIndent}
\setlength{\otIndent}{10.5mm}

% En-tête : pastille + titre + (difficulté) + renvoi
\newsavebox{\otDroiteBox}
% Place minimale avant un en-tête. Par défaut, \needspace garde les exercices d'un seul tenant ;
% en mode « souple » (corrigés longs, pleine largeur), on ne change de page que si la place manque,
% ce qui permet de couper un corrigé entre deux questions plutôt que de laisser un blanc.
% Tolérance supplémentaire pour les paragraphes difficiles (code en ligne insécable)
\setlength{\emergencystretch}{1.5em}
\newif\ifotSouple
\newif\ifotApresRubrique
\newcommand{\otBesoinPlace}[1]{%
  \ifotSouple
    \par\if@nobreak\else\penalty\z@\fi
    \begingroup\setlength{\dimen@}{#1}\dimen@ii\pagegoal\advance\dimen@ii-\pagetotal
      \ifdim\dimen@>\dimen@ii\ifdim\dimen@ii>\z@\vfil\fi\break\fi
    \endgroup
  \else\needspace{#1}\fi}
\newcommand{\miseEnPageSouple}{\global\otSoupletrue}
\let\corrigesSouples\miseEnPageSouple
\newcommand{\otEntete}[5]{% #1 couleur, #2 numéro, #3 titre, #4 difficulté, #5 renvoi
  \ifotApresRubrique
    \par\global\otApresRubriquefalse\addvspace{6.5mm}%
  \else
    \par\addvspace{6.5mm}\otBesoinPlace{9\baselineskip}%
  \fi
  \sbox{\otDroiteBox}{\ifnum#4>0\relax\otDots{#4}\hspace{3mm}\fi
    {\otMedium\fontsize{7}{9}\selectfont\color{otMuted}#5}}%
  \noindent\makebox[\otIndent][l]{\otNumBox[#1]{#2}}%
  \parbox[t]{\dimexpr\linewidth-\otIndent-\wd\otDroiteBox-4mm\relax}%
    {\raggedright\otSemi\fontsize{10.5}{13}\selectfont\leavevmode\color{otInk}#3}%
  \hfill\usebox{\otDroiteBox}%
  \par\nopagebreak\vspace{2mm}\@nobreaktrue}

\newenvironment{otCorps}{%
  \ifotSouple\@beginparpenalty\@M\fi
