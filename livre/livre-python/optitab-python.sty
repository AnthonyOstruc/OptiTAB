%%  Les clés run, suite, bug, trous, cible, norun… ne servent qu'au vérificateur.
%% ---------------------------------------------------------------------
\pgfkeys{/otcode/.is family,/otcode,
  file/.store in=\otCodeFichier, marks/.store in=\otCodeMarques, first/.store in=\otCodePremier,
  title/.store in=\otCodeTitre, nonum/.code={\otCodeNumfalse}, mini/.code={\def\otCodeMini{1}},
  run/.code={}, suite/.code={}, bug/.code={}, trous/.code={}, norun/.code={}, cible/.code={},
  erreur/.code={}, aleatoire/.code={}, stdin/.code={}, nocheck/.code={}, setup/.code={}, variante/.code={}}
\newcommand{\otCodeReglages}[1]{%
  \def\otCodeFichier{}\def\otCodeMarques{}\def\otCodePremier{1}\def\otCodeTitre{}\def\otCodeMini{0}%
  \otCodeNumtrue\pgfkeys{/otcode,#1}%
  \ifx\otCodeMini\otUn\otCodeNumfalse\fi}
\def\otUn{1}
% écart unique après un bloc de code : une sortie qui suit immédiatement s'y accole
\newlength{\otApresCode}\setlength{\otApresCode}{3.53mm}
\tcbset{
  otCodeBoite/.style={enhanced,colback=otCodeFond,colframe=otCodeFond,arc=1.6mm,boxrule=0pt,
    left=\otGouttiere,right=3.5mm,top=2mm,bottom=2mm,boxsep=0pt,before skip=3.5mm,after skip=\otApresCode,
    fonttitle=\otSemi\fontsize{7.6}{9}\selectfont,coltitle=otNavy,colbacktitle=otCodeTitre,
    toptitle=1.3mm,bottomtitle=1.1mm,lefttitle=3.5mm,righttitle=3.5mm,titlerule=0pt},
  otEcranBoite/.style={enhanced,colback=otEcran,colframe=otEcran,arc=1.6mm,boxrule=0pt,
    left=4mm,right=4mm,top=2mm,bottom=2.2mm,boxsep=0pt,before skip=3.5mm,after skip=3.5mm,
    fonttitle=\otSemi\fontsize{7}{8.5}\selectfont,coltitle=otEcranMuet,colbacktitle=otEcranTitre,
    toptitle=1.1mm,bottomtitle=1mm,lefttitle=4mm,righttitle=4mm,titlerule=0pt},
  otCasseOui/.style={breakable},otCasseNon/.style={}}
