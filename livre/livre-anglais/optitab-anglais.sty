\newcommand{\otAvatar@sam}{%
  \otAvatarCorps{otTeal}
  \otAvatarVisage{otPeau4}{otInk}
  \foreach \a in {160,135,110,90,70,45,20}{\fill[otCheveuNoir] (0,0.08) ++(\a:0.36) circle (0.12);}
  \fill[otCheveuNoir] (-0.33,0.18) .. controls (-0.3,0.48) and (0.3,0.48) .. (0.33,0.18) .. controls (0.2,0.3) and (-0.2,0.3) .. cycle;}
% \otDessinAvatar{clé}{centre}{rayon}{fond}
\newcommand{\otDessinAvatar}[4]{%
  \pgfmathsetlength{\otIcoU}{#3}%
  \begin{scope}[shift={#2},x=\otIcoU,y=\otIcoU]
    \fill[#4] (0,0) circle (1);
    \begin{scope}\clip (0,0) circle (1);\csname otAvatar@#1\endcsname\end{scope}
  \end{scope}}
\NewDocumentCommand{\otAvatar}{O{otNavyTint} m m}{% fond, clé, diamètre
  \tikz[baseline={(0,-0.3*#3)}]{\otDessinAvatar{#2}{(0,0)}{0.5*#3}{#1}}}

