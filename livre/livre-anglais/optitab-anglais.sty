\newcommand{\otTitreBoite}[4]{% icône, couleur, étiquette, intitulé
  \noindent\otTuile[5mm]{#1}{#2}\hspace{2.2mm}\otEtiquette{#2}{#3}%
  \if\relax\detokenize{#4}\relax\else\hspace{1.8mm}{\otMedium\fontsize{9.2}{11}\selectfont\color{otInk}#4}\fi
  \par\vspace{1.8mm}}
