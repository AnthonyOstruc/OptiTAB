    inner sep=0pt,text=white,font=\otBold\fontsize{9}{9}\selectfont] (n) {#1};%
  \hspace{2.4mm}{\otSemi\fontsize{10.8}{13}\selectfont\ifcsname r@ex-\otCorPref-#1\endcsname\nameref{ex-\otCorPref-#1}\fi}%
  \hfill{\otLight\fontsize{7}{9}\selectfont\color{otMuted}exercise p.~\pageref{ex-\otCorPref-#1}}\par\nopagebreak\vspace{2mm}%
  \fontsize{10.4}{13.2}\selectfont}
  {\par}
\NewDocumentEnvironment{corrigeatoi}{m}{% numéro du « Your turn »
