    \foreach \i in {1,...,#1}{%
      \draw[otMuted!70,line width=0.4pt] (\i*3.9mm-2mm,0) circle (1.6mm);
      \node[text=otMuted,font=\otMedium\fontsize{4.4}{5}\selectfont] at (\i*3.9mm-2mm,0) {\i};}
  \end{tikzpicture}}

\newcommand{\tableauDeBord}{%
  \begingroup
  \renewcommand{\otPlanPartie}[2]{%
    \par\addvspace{2.6mm}\noindent
    {\otSemi\fontsize{7}{9}\selectfont\color{otGreenDark}\otCaps[16]{Partie ##1 · ##2}}\par
    \vspace{1.1mm}{\color{otNavy}\hrule height 0.6pt}\vspace{1.1mm}}%
  \renewcommand{\otPlanChap}[3]{%
    \noindent\makebox[8mm][l]{\otNumBoxPetit{\otTwoDigits{##1}}}%
    \makebox[66mm][l]{\otRegular\fontsize{7.8}{10}\selectfont ##2}%
    \makebox[61mm][l]{\otCercles{##3}}%
    \hfill{\otLight\fontsize{7}{9}\selectfont\color{otMuted}fini le \rule[-0.6mm]{7mm}{0.3pt}/\rule[-0.6mm]{7mm}{0.3pt}}%
    \par\vspace{0.7mm}{\color{otRule}\hrule height 0.3pt}\vspace{0.75mm}}%
  \input{plan}%
  \endgroup}

%% ---------------------------------------------------------------------
%%  L'essentiel : synthèse de cours en début de chapitre
%% ---------------------------------------------------------------------
\RequirePackage{array,tabularx,booktabs,colortbl}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}

% Début de la synthèse (nouvelle page)
\newcommand{\essentiel}{%
  \clearpage
  \markright{L'essentiel}%
  \phantomsection\label{ess-\otChapNum}%
  \noindent{\otLight\fontsize{28}{32}\selectfont\color{otInk}L'essentiel}%
  \hfill\parbox[b]{0.6\linewidth}{\raggedleft\otMedium\fontsize{7.5}{10}\selectfont\color{otMuted}%
    \otCaps[10]{Chapitre \otTwoDigits{\otChapNum} · \otChapTitle}\strut}\par
  \vspace{3.5mm}%
  \noindent{\color{otNavy}\rule[0pt]{16mm}{1.3pt}}%
  {\color{otRule}\rule[0.45pt]{\dimexpr\linewidth-16mm\relax}{0.4pt}}\par
  \vspace{4mm}}

% Section numérotée de la synthèse : \essSection{numéro}{titre}
\newcommand{\essSection}[2]{%
  \par\addvspace{7mm}%
  \noindent{\otBold\fontsize{12}{14}\selectfont\color{otNavy}#1}%
  \hspace{3mm}{\otSemi\fontsize{12}{14}\selectfont\color{otInk}#2}\par\nopagebreak
  \vspace{1.6mm}{\color{otRule}\hrule height 0.4pt}\nopagebreak\vspace{3.5mm}\nopagebreak}

% Début des exercices (nouvelle page)
\newcommand{\exercices}{\clearpage}

% Encadrés de cours
\newcommand{\otEtiq}[2]{{\otSemi\fontsize{7}{9}\selectfont\color{#1}\otCaps[12]{#2}}}
\newcommand{\otNomEncadre}[1]{\IfValueT{#1}{\enspace{\otMedium\fontsize{9}{11}\selectfont\color{otInk}#1}}}
\tcbset{otEncadre/.style={enhanced,sharp corners,boxrule=0pt,
  left=5mm,right=5mm,top=3.4mm,bottom=3.4mm,before skip=4mm,after skip=4mm,
  fontupper=\fontsize{10.5}{14}\selectfont,parbox=false}}
\NewDocumentEnvironment{definition}{o}{%
  \begin{tcolorbox}[otEncadre,colback=otNavyTint,borderline west={1.3mm}{0pt}{otNavy}]
  \otEtiq{otNavy}{Définition}\otNomEncadre{#1}\par\vspace{1.4mm}}
  {\end{tcolorbox}}
\NewDocumentEnvironment{theoreme}{o}{%
  \begin{tcolorbox}[otEncadre,colback=white,colframe=otNavy,boxrule=0.6pt,
    arc=1.8mm,rounded corners,top=3.4mm]
  \otEtiq{otNavy}{Théorème}\otNomEncadre{#1}\par\vspace{1.4mm}}
  {\end{tcolorbox}}
\NewDocumentEnvironment{propriete}{o}{%
  \begin{tcolorbox}[otEncadre,colback=white,colframe=otNavy!45,boxrule=0.5pt,
    arc=1.8mm,rounded corners]
  \otEtiq{otNavy}{Propriété}\otNomEncadre{#1}\par\vspace{1.4mm}}
  {\end{tcolorbox}}
\NewDocumentEnvironment{savoirfaire}{o}{%
  \begin{tcolorbox}[otEncadre,colback=otGreenTint,borderline west={1.3mm}{0pt}{otGreen}]
  \otEtiq{otGreenDark}{Méthode}\otNomEncadre{#1}\par\vspace{1.4mm}}
  {\end{tcolorbox}}
\NewDocumentEnvironment{attention}{o}{%
  \begin{tcolorbox}[otEncadre,colback=otOrange!10,borderline west={1.3mm}{0pt}{otOrange}]
  \otEtiq{otOrange!75!black}{Attention}\otNomEncadre{#1}\par\vspace{1.4mm}}
  {\end{tcolorbox}}
\NewDocumentEnvironment{exemple}{o}{%
  \begin{tcolorbox}[otEncadre,colback=white,borderline west={0.8pt}{0pt}{otRule},
    top=1mm,bottom=1mm,left=4.5mm]
  \otEtiq{otMuted}{Exemple}\otNomEncadre{#1}\par\vspace{1.4mm}}
  {\end{tcolorbox}}
\NewDocumentEnvironment{demonstration}{o}{%
  \begin{tcolorbox}[otEncadre,colback=white,colframe=otRule,boxrule=0.5pt,
    arc=1.8mm,rounded corners]
  \otEtiq{otMuted}{Démonstration}\otNomEncadre{#1}\par\vspace{1.4mm}}
  {\hfill\tikz[baseline=0pt]\draw[otMuted,line width=0.5pt] (0,0) rectangle (1.8mm,1.8mm);\end{tcolorbox}}

% Étapes d'un raisonnement : \etape{Initialisation}
\newcommand{\etape}[1]{{\otSemi\fontsize{7.5}{9}\selectfont\color{otNavy}#1\enspace}}

% Parties d'un problème : \partieExo{A}{titre}
\newcommand{\partieExo}[2]{%
  \par\addvspace{3.5mm}\otBesoinPlace{4\baselineskip}\noindent
  {\otSemi\fontsize{7.5}{9}\selectfont\color{otGreenDark}\otCaps[14]{Partie #1}}%
  \hspace{2.5mm}{\otMedium\fontsize{9.5}{12}\selectfont\color{otInk}#2}\par\nopagebreak
  \vspace{-1.2mm}}

% Code Python
\RequirePackage{listings}
\newfontfamily\otMono{FiraMono}[Extension=.otf,UprightFont=*-Regular,BoldFont=*-Medium]
\lstdefinestyle{otPython}{language=Python,
  basicstyle=\NoAutoSpacing\otMono\fontsize{8.6}{12}\selectfont\color{otInk},
  literate={*}{{\char42}}1,
  keywordstyle=\color{otNavy}\bfseries,
  commentstyle=\color{otMuted},
  stringstyle=\color{otGreenDark},
  columns=fullflexible,keepspaces=true,showstringspaces=false,upquote=true,
  morekeywords={True,False,None}}
\tcbset{otAvantColle/.style={before={%
    \ifnum\lastnodetype=-1\relax\else
      \par\ifotSouple\nopagebreak\fi
      \ifvmode
        \iftcb@minipage\ifdim\parskip>\z@\relax\addvspace{-\parskip}\fi
        \else\addvspace{\glueexpr#1-\parskip}\fi
        \nointerlineskip
      \fi
    \fi
    \lineskip\z@skip\noindent}}}
\tcbset{otBoitePython/.style={enhanced,listing only,listing options={style=otPython},
  colback=otNavyTint,colframe=otNavyTint,boxrule=0pt,arc=1.8mm,
  left=4.5mm,right=4mm,top=1.5mm,bottom=1.5mm,otAvantColle=3mm,after skip=3mm,
  overlay={\node[anchor=north east,inner sep=1.6mm,text=otMuted,
    font=\otSemi\fontsize{6}{7}\selectfont] at (frame.north east) {\otCaps[10]{Python}};}}}
\newtcblisting{python}{otBoitePython}

% Affichage produit par un programme (console)
\tcbset{otBoiteConsole/.style={enhanced,listing only,
  listing options={basicstyle=\NoAutoSpacing\otMono\fontsize{8.4}{11.6}\selectfont\color{otInk},
    columns=fullflexible,keepspaces=true,showstringspaces=false,upquote=true,literate={*}{{\char42}}1},
  colback=white,colframe=otRule,boxrule=0.5pt,arc=1.8mm,
  left=4.5mm,right=4mm,top=1.5mm,bottom=1.5mm,otAvantColle=2mm,after skip=3mm,
  overlay={\node[anchor=north east,inner sep=1.6mm,text=otMuted,
    font=\otSemi\fontsize{6}{7}\selectfont] at (frame.north east) {\otCaps[10]{Affichage}};}}}
\newtcblisting{console}{otBoiteConsole}

% Programme et affichage côte à côte :
%   \begin{codecote}[part de la largeur pour le code]
%     \begin{pythoncol} ... \end{pythoncol}
%   \cote
%     \begin{consolecol} ... \end{consolecol}  (ou du texte)
%   \end{codecote}
\newtcblisting{pythoncol}{otBoitePython,before skip=0pt,after skip=0pt}
\newtcblisting{consolecol}{otBoiteConsole,before skip=0pt,after skip=0pt}
\NewDocumentEnvironment{codecote}{O{0.6}}{%
  \par\ifotSouple\nopagebreak\fi\addvspace{2.5mm}\nointerlineskip\def\otCoteLarg{#1}%
  \noindent\begin{minipage}[t]{#1\linewidth}\vspace{0pt}}
  {\end{minipage}\par\addvspace{2.5mm}}
\newcommand{\cote}{%
  \end{minipage}\hfill
  \begin{minipage}[t]{\dimexpr\linewidth-\otCoteLarg\linewidth-4mm\relax}\vspace{0pt}\raggedright}

% Code en ligne
\newcommand{\code}[1]{\leavevmode\mbox{\NoAutoSpacing\otMono\fontsize{8.8}{11}\selectfont\color{otNavyDark}#1}}
% Cellules de tableau : en-tête de colonne, nom de ligne
\newcommand{\otTete}[1]{\leavevmode{\otSemi\fontsize{8}{10}\selectfont #1}}
\newcommand{\otNom}[1]{\leavevmode{\otSemi\fontsize{7.5}{10}\selectfont\color{otNavy}#1}}
% Résultat surligné sous forme de code (corrigés)
\newcommand{\resc}[1]{\res{\text{\code{#1}}}}

