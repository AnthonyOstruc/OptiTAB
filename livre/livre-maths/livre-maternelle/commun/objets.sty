\tikzset{
  % Les couleurs passées aux illustrations peuvent être des mélanges (matBrun!80) :
  % on les fige sous un nom simple pour pouvoir les teinter ensuite (\matC!50).
  mat/c/.code={\colorlet{matCouleurA}{#1}\def\matC{matCouleurA}}, mat/c=matRouge,
  mat/c2/.code={\colorlet{matCouleurB}{#1}\def\matCC{matCouleurB}}, mat/c2=matVert,
  mat/n/.store in=\matN, mat/n=1,
  mat/l/.store in=\matL, mat/l=3,
  mat contour/.style={line width=1.1pt,draw=matTrait,line join=round,line cap=round},
  mat fin/.style={line width=.7pt,draw=matTrait,line join=round,line cap=round},
  mat reflet/.style={fill=white,opacity=.55},
}

