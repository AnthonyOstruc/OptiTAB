\NewDocumentCommand{\partie}{m m m m m m}{%
  \otPageDroite
  \gdef\otPartieNum{#1}\gdef\otPartieNom{#2}\gdef\otPartieCouleur{#4}%
  \gdef\otChapNum{0}%
