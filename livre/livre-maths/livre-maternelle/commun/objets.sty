%% =====================================================================
%%  objets.sty — bibliothèque d'illustrations vectorielles OptiTAB Maternelle
%%  Chaque objet est un « pic » TikZ tenant dans un carré d'environ 1 x 1,
%%  centré sur l'origine. Couleur principale : mat/c ; secondaire : mat/c2.
%% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{objets}[2026/10/23 Illustrations OptiTAB Maternelle]
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,shapes.geometric,decorations.pathmorphing}

\definecolor{matTrait}{HTML}{2B2F45}
