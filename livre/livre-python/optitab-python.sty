%% ---------------------------------------------------------------------
%%  Icônes (dessinées en coordonnées [-0,5 ; 0,5], unité \otIcoU)
%%  \otIco@clé{couleur}{couleur du fond}
%% ---------------------------------------------------------------------
\newlength{\otIcoU}
\newcommand{\otIco@livre}[2]{%
  \fill[#1] (-0.47,-0.3) -- (-0.47,0.34) .. controls (-0.27,0.4) and (-0.12,0.37) .. (-0.04,0.28)
    -- (-0.04,-0.37) .. controls (-0.12,-0.29) and (-0.27,-0.26) .. cycle;
  \fill[#1] (0.47,-0.3) -- (0.47,0.34) .. controls (0.27,0.4) and (0.12,0.37) .. (0.04,0.28)
    -- (0.04,-0.37) .. controls (0.12,-0.29) and (0.27,-0.26) .. cycle;}
\newcommand{\otIco@ampoule}[2]{%
  \fill[#1] (0,0.13) circle (0.3);
  \fill[#1] (-0.15,-0.2) rectangle (0.15,0.0);
  \fill[#1,rounded corners=0.04*\otIcoU] (-0.13,-0.43) rectangle (0.13,-0.25);
  \draw[#2,line width=0.06*\otIcoU] (-0.15,-0.22) -- (0.15,-0.22);}
\newcommand{\otIco@attention}[2]{%
  \fill[#1,rounded corners=0.06*\otIcoU] (0,0.46) -- (0.5,-0.4) -- (-0.5,-0.4) -- cycle;
  \fill[#2,rounded corners=0.03*\otIcoU] (-0.045,-0.08) rectangle (0.045,0.24);
  \fill[#2] (0,-0.23) circle (0.055);}
\newcommand{\otIco@etoile}[2]{%
  \fill[#1] (90:0.48) -- (126:0.2) -- (162:0.48) -- (198:0.2) -- (234:0.48) -- (270:0.2)
    -- (306:0.48) -- (342:0.2) -- (18:0.48) -- (54:0.2) -- cycle;}
\newcommand{\otIco@horloge}[2]{%
  \draw[#1,line width=0.085*\otIcoU] (0,0) circle (0.42);
  \draw[#1,line width=0.09*\otIcoU,line cap=round] (0,0.24) -- (0,0) -- (0.17,-0.1);}
\newcommand{\otIco@cible}[2]{%
  \draw[#1,line width=0.08*\otIcoU] (0,0) circle (0.42) (0,0) circle (0.24);
  \fill[#1] (0,0) circle (0.09);}
\newcommand{\otIco@coche}[2]{%
  \draw[#1,line width=0.085*\otIcoU] (0,0) circle (0.42);
  \draw[#1,line width=0.11*\otIcoU,line cap=round,line join=round] (-0.2,0.01) -- (-0.05,-0.15) -- (0.22,0.16);}
\newcommand{\otIco@crayon}[2]{%
  \begin{scope}[rotate=45]
    \fill[#1,rounded corners=0.04*\otIcoU] (-0.5,-0.12) rectangle (-0.34,0.12);
    \fill[#1] (-0.29,-0.12) rectangle (0.22,0.12);
    \fill[#1] (0.27,-0.12) -- (0.5,0) -- (0.27,0.12) -- cycle;
  \end{scope}}
\newcommand{\otIco@bulle}[2]{%
  \fill[#1,rounded corners=0.13*\otIcoU] (-0.46,-0.2) -- (-0.46,0.42) -- (0.46,0.42) -- (0.46,-0.2) -- (-0.02,-0.2) -- (-0.3,-0.46) -- (-0.24,-0.2) -- cycle;
  \draw[#2,line width=0.085*\otIcoU,line cap=round] (-0.25,0.19) -- (0.25,0.19) (-0.25,0.01) -- (0.1,0.01);}
\newcommand{\otIco@blocs}[2]{%
  \fill[#1,rounded corners=0.07*\otIcoU] (-0.46,-0.44) rectangle (-0.04,-0.02);
  \fill[#1,rounded corners=0.07*\otIcoU] (0.04,-0.44) rectangle (0.46,-0.02);
  \fill[#1,rounded corners=0.07*\otIcoU] (-0.21,0.06) rectangle (0.21,0.48);}
\newcommand{\otIco@globe}[2]{%
  \draw[#1,line width=0.08*\otIcoU] (0,0) circle (0.42);
  \draw[#1,line width=0.065*\otIcoU] (0,0) ellipse (0.17 and 0.42);
  \draw[#1,line width=0.065*\otIcoU] (-0.42,0) -- (0.42,0) (-0.37,0.2) -- (0.37,0.2) (-0.37,-0.2) -- (0.37,-0.2);}
\newcommand{\otIco@engrenage}[2]{%
  \foreach \a in {0,45,...,315}{\fill[#1,rotate=\a,rounded corners=0.02*\otIcoU] (-0.085,0.25) rectangle (0.085,0.47);}
  \fill[#1] (0,0) circle (0.33);
  \fill[#2] (0,0) circle (0.13);}
\newcommand{\otIco@bug}[2]{%
  \draw[#1,line width=0.07*\otIcoU,line cap=round]
    (-0.18,0.04) -- (-0.43,0.14) (0.18,0.04) -- (0.43,0.14)
    (-0.2,-0.12) -- (-0.45,-0.12) (0.2,-0.12) -- (0.45,-0.12)
    (-0.17,-0.27) -- (-0.4,-0.42) (0.17,-0.27) -- (0.4,-0.42)
    (-0.07,0.36) -- (-0.18,0.49) (0.07,0.36) -- (0.18,0.49);
  \fill[#1] (0,-0.1) ellipse (0.23 and 0.31);
  \fill[#1] (0,0.27) circle (0.14);
  \draw[#2,line width=0.05*\otIcoU] (0,0.17) -- (0,-0.38);}
\newcommand{\otIco@fusee}[2]{%
  \begin{scope}[rotate=-40]
    \fill[#1] (-0.17,-0.06) -- (-0.36,-0.32) -- (-0.15,-0.24) -- cycle;
    \fill[#1] (0.17,-0.06) -- (0.36,-0.32) -- (0.15,-0.24) -- cycle;
    \fill[#1] (0,0.5) .. controls (0.22,0.3) and (0.19,0.0) .. (0.15,-0.24) -- (-0.15,-0.24)
      .. controls (-0.19,0.0) and (-0.22,0.3) .. (0,0.5);
    \fill[#2] (0,0.13) circle (0.075);
    \fill[#1] (-0.09,-0.3) -- (0,-0.5) -- (0.09,-0.3) -- cycle;
  \end{scope}}
\newcommand{\otIco@terminal}[2]{%
  \draw[#1,line width=0.08*\otIcoU,rounded corners=0.09*\otIcoU] (-0.46,-0.38) rectangle (0.46,0.38);
  \draw[#1,line width=0.09*\otIcoU,line cap=round,line join=round] (-0.27,0.15) -- (-0.08,0) -- (-0.27,-0.15);
  \draw[#1,line width=0.09*\otIcoU,line cap=round] (0.02,-0.17) -- (0.27,-0.17);}
\newcommand{\otIco@chevrons}[2]{%
  \draw[#1,line width=0.1*\otIcoU,line cap=round,line join=round] (-0.2,0.25) -- (-0.45,0) -- (-0.2,-0.25);
  \draw[#1,line width=0.1*\otIcoU,line cap=round,line join=round] (0.2,0.25) -- (0.45,0) -- (0.2,-0.25);
  \draw[#1,line width=0.09*\otIcoU,line cap=round] (0.09,0.38) -- (-0.09,-0.38);}
\newcommand{\otIco@cle}[2]{%
  \draw[#1,line width=0.11*\otIcoU] (-0.27,0) circle (0.17);
  \fill[#1] (-0.1,-0.045) rectangle (0.46,0.045);
  \fill[#1] (0.27,-0.045) rectangle (0.33,-0.2) (0.38,-0.045) rectangle (0.44,-0.16);}
\newcommand{\otIco@oeil}[2]{%
  \fill[#1] (-0.49,0) .. controls (-0.22,0.38) and (0.22,0.38) .. (0.49,0)
    .. controls (0.22,-0.38) and (-0.22,-0.38) .. cycle;
  \fill[#2] (0,0) circle (0.17);
  \fill[#1] (0,0) circle (0.08);}
\newcommand{\otIco@puzzle}[2]{%
  \fill[#1,rounded corners=0.04*\otIcoU] (-0.38,-0.4) rectangle (0.26,0.24);
  \fill[#1] (-0.06,0.31) circle (0.13);
  \fill[#1] (0.33,-0.08) circle (0.13);
  \fill[#2] (-0.38,-0.08) circle (0.1);
  \fill[#2] (-0.06,-0.4) circle (0.1);}
\newcommand{\otIco@clavier}[2]{%
  \fill[#1,rounded corners=0.08*\otIcoU] (-0.49,-0.31) rectangle (0.49,0.31);
  \foreach \x in {-0.33,-0.11,0.11,0.33}{\fill[#2] (\x-0.07,0.09) rectangle (\x+0.07,0.19);}
  \foreach \x in {-0.22,0,0.22}{\fill[#2] (\x-0.07,-0.06) rectangle (\x+0.07,0.04);}
  \fill[#2] (-0.25,-0.21) rectangle (0.25,-0.14);}
\newcommand{\otIco@trophee}[2]{%
  \draw[#1,line width=0.07*\otIcoU,line join=round] (-0.24,0.34) -- (-0.42,0.34) -- (-0.38,0.18) -- (-0.18,0.07);
  \draw[#1,line width=0.07*\otIcoU,line join=round] (0.24,0.34) -- (0.42,0.34) -- (0.38,0.18) -- (0.18,0.07);
  \fill[#1] (-0.27,0.44) -- (0.27,0.44) -- (0.23,0.1) .. controls (0.18,-0.07) and (-0.18,-0.07) .. (-0.23,0.1) -- cycle;
  \fill[#1] (-0.06,-0.06) rectangle (0.06,-0.28);
  \fill[#1,rounded corners=0.03*\otIcoU] (-0.21,-0.44) rectangle (0.21,-0.28);}
\newcommand{\otIco@fichier}[2]{%
  \fill[#1] (-0.33,-0.47) -- (-0.33,0.47) -- (0.12,0.47) -- (0.35,0.24) -- (0.35,-0.47) -- cycle;
  \fill[#2,opacity=0.55] (0.12,0.47) -- (0.12,0.24) -- (0.35,0.24) -- cycle;
  \draw[#2,line width=0.065*\otIcoU,line cap=round] (-0.18,0.02) -- (0.2,0.02) (-0.18,-0.15) -- (0.2,-0.15) (-0.18,-0.32) -- (0.08,-0.32);}
\newcommand{\otIco@telecharger}[2]{%
  \draw[#1,line width=0.1*\otIcoU,line cap=round] (0,0.46) -- (0,-0.12);
  \draw[#1,line width=0.1*\otIcoU,line cap=round,line join=round] (-0.21,0.09) -- (0,-0.13) -- (0.21,0.09);
  \draw[#1,line width=0.1*\otIcoU,line cap=round,line join=round] (-0.43,-0.1) -- (-0.43,-0.42) -- (0.43,-0.42) -- (0.43,-0.1);}
\newcommand{\otIco@lecture}[2]{%
  \fill[#1,rounded corners=0.05*\otIcoU] (-0.27,0.38) -- (0.4,0) -- (-0.27,-0.38) -- cycle;}
\newcommand{\otIco@ecran}[2]{%
  \fill[#1,rounded corners=0.06*\otIcoU] (-0.48,-0.2) rectangle (0.48,0.42);
  \fill[#2,opacity=0.5] (-0.4,-0.12) rectangle (0.4,0.34);
  \fill[#1] (-0.06,-0.2) rectangle (0.06,-0.36);
  \fill[#1,rounded corners=0.03*\otIcoU] (-0.25,-0.44) rectangle (0.25,-0.34);}
\newcommand{\otIco@dossier}[2]{%
  \fill[#1,rounded corners=0.05*\otIcoU] (-0.47,-0.38) -- (-0.47,0.36) -- (-0.12,0.36) -- (-0.02,0.24) -- (0.47,0.24) -- (0.47,-0.38) -- cycle;
  \fill[#2,opacity=0.3] (-0.47,0.12) rectangle (0.47,0.16);}
\newcommand{\otIco@boucle}[2]{%
  \draw[#1,line width=0.1*\otIcoU,line cap=round] (0.36,0.1) arc[start angle=15,end angle=300,radius=0.36];
  \fill[#1] (0.22,0.24) -- (0.5,0.24) -- (0.4,-0.02) -- cycle;}
% Dessin d'une icône dans une figure TikZ : \otDessinIcone{clé}{couleur}{fond}{taille}{centre}
\newcommand{\otDessinIcone}[5]{%
  \pgfmathsetlength{\otIcoU}{#4}%
  \begin{scope}[shift={#5},x=\otIcoU,y=\otIcoU]\csname otIco@#1\endcsname{#2}{#3}\end{scope}}
\newcommand{\otIconeSeule}[3]{\tikz[baseline=0pt]{\path (0,0) rectangle (#3,#3);
  \otDessinIcone{#1}{#2}{white}{#3}{(0.5*#3,0.5*#3)}}}
% Tuile : carré arrondi coloré + icône blanche : \otTuile[taille]{clé}{couleur}
\NewDocumentCommand{\otTuile}{O{6mm} m m}{%
  \tikz[baseline={(0,0.28*#1)}]{\fill[#3,rounded corners=0.22*#1] (0,0) rectangle (#1,#1);
    \otDessinIcone{#2}{white}{#3}{0.6*#1}{(0.5*#1,0.5*#1)}}}

