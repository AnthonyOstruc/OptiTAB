    raster before skip=0pt,raster after skip=0pt]
    \otCartePrg{ampoule}{otNavy}{Concepts}{#1}
    \otCartePrg{chevrons}{otViolet}{Python}{#2}
    \otCartePrg{engrenage}{otTeal}{Tools}{#3}
    \otCartePrg{etoile}{otOrangeDark}{Good habits}{#4}
    \otCartePrg{fusee}{otGreenDark}{You'll build}{#5}
  \end{tcbraster}\par\vspace{3.4mm}}
% Plan de travail : \seances{icône/couleur/titre/contenu, ...}
\newcommand{\seances}[2][4]{%
  \par\noindent{\otSemi\fontsize{12}{14}\selectfont\color{otInk}Your study plan}%
  \hspace{2mm}{\otRegular\fontsize{9.4}{12}\selectfont\color{otMuted}#1 sessions of about 45 minutes}\par\vspace{2.6mm}
  \pgfmathsetmacro{\otPas}{170/#1}%
  \noindent\begin{tikzpicture}
    \foreach \ico/\coul/\titre/\txt [count=\i] in {#2}{%
      \pgfmathsetmacro{\xx}{(\i-1)*\otPas}
      \fill[\coul] (\xx mm+4.5mm,0) circle (4.5mm);
      \otDessinIcone{\ico}{white}{\coul}{5mm}{(\xx mm+4.5mm,0)}
      \ifnum\i<#1\draw[otRule,line width=0.8pt] (\xx mm+10.5mm,0) -- (\xx mm+\otPas mm-2mm,0);\fi
      \node[anchor=north west,inner sep=0pt,text width=\otPas mm-4mm,align=left] at (\xx mm,-6.8mm)
        {\RaggedRight{\otSemi\fontsize{6.6}{8}\selectfont\color{\coul}\otCaps[10]{Session \i}}\par\vspace{0.6mm}
         {\otSemi\fontsize{8.6}{10.4}\selectfont\color{otInk}\titre}\par\vspace{0.4mm}
         {\fontsize{8.4}{10.2}\selectfont\color{otMuted}\txt}};}
  \end{tikzpicture}\par}

