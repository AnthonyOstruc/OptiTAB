  \begin{tikzpicture}[baseline=(n.base)]
    \node[fill=\otPartieCouleur,rounded corners=1.4pt,minimum width=6mm,minimum height=6mm,
      inner sep=0pt,text=white,font=\otBold\fontsize{9.5}{10}\selectfont] (n) {\theotsect};
  \end{tikzpicture}\hspace{2.6mm}%
  {\otSemi\fontsize{12.5}{15}\selectfont\color{otInk}#1}%
  \hspace{3mm}{\color{otRule}\leaders\hrule height 0.45pt\hfill\kern0pt}\par
  \nopagebreak\vspace{2.6mm}}

