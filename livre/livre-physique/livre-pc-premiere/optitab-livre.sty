%% Page de droite garantie : la page paire laissée libre devient une page « Notes »
\newcommand{\otPageNotes}{%
  \thispagestyle{empty}%
  \noindent{\otLight\fontsize{22}{26}\selectfont\color{otInk}Notes}\par\vspace{2.5mm}%
  \noindent{\color{otNavy}\rule{12mm}{0.6pt}}\par\vspace{9mm}%
  \noindent\begin{tikzpicture}
    \foreach \k in {0,...,24}{\draw[otRule,line width=0.4pt] (0.2pt,-\k*8mm) -- ({\linewidth-0.2pt},-\k*8mm);}
  \end{tikzpicture}\par
  \newpage}
\newcommand{\otCleardoublepage}{%
  \clearpage\ifodd\value{page}\else\otPageNotes\fi}

%% ---------------------------------------------------------------------
%%  Onglets de chapitre (bord extérieur de la page)
%% ---------------------------------------------------------------------
\newcommand{\otThumb}{%
  \ifnum\otChapNum>0\relax
  \begin{tikzpicture}[remember picture,overlay]
    \pgfmathsetmacro{\otThumbY}{22+(\otChapNum-1)*9.3}
    \ifodd\value{page}
      \fill[\otAccent] ([yshift=-\otThumbY mm]current page.north east)
        rectangle ++(-7.5mm,-8.4mm);
      \node[text=white,font=\otSemi\fontsize{7.5}{8}\selectfont]
        at ([xshift=-3.75mm,yshift=-\otThumbY mm-4.2mm]current page.north east)
        {\otTwoDigits{\otChapNum}};
    \else
      \fill[\otAccent] ([yshift=-\otThumbY mm]current page.north west)
        rectangle ++(7.5mm,-8.4mm);
      \node[text=white,font=\otSemi\fontsize{7.5}{8}\selectfont]
        at ([xshift=3.75mm,yshift=-\otThumbY mm-4.2mm]current page.north west)
        {\otTwoDigits{\otChapNum}};
    \fi
  \end{tikzpicture}\fi}

