    \coordinate (-haut) at (0,\pcH); \coordinate (-robinet) at (0.42,0.72); \coordinate (-pointe) at (0,0);
    \coordinate (-tube) at (0.12,{\pcH-1.2});}},
  pics/burette/.default={},
  % Agitateur magnétique : largeur ; le récipient se pose en (0,0.5)
  pics/agitateur/.style={code={%
    \pcDefauts{largeur=2.6,#1}%
    \pgfmathsetmacro\pcl{\pcL/2}%
    \filldraw[pcAppareil,rounded corners=1.2mm] ({-\pcl},0) rectangle ({\pcl},0.5);
    \draw[otInk!60,line width=0.5pt] ({-\pcl+0.1},0.42) -- ({\pcl-0.1},0.42);
    \filldraw[fill=white,draw=otInk!70,line width=0.5pt] ({\pcl-0.38},0.2) circle (0.12);
    \draw[otInk!70,line width=0.5pt] ({\pcl-0.38},0.2) -- ({\pcl-0.38},0.3);
    \coordinate (-dessus) at (0,0.5); \coordinate (-face) at ({-\pcl},0.25);}},
  pics/agitateur/.default={},
  pics/barreau/.style={code={%
    \filldraw[fill=otInk!65,draw=otInk!80,line width=0.3pt,rounded corners=0.5mm] (-0.24,0) rectangle (0.24,0.1);}},
  % Sonde de pH (électrode combinée) : origine au bas de la sonde
  pics/sonde/.style={code={%
