  \hrule\@height\headrulewidth\@width\headwidth\vskip-\headrulewidth}}
\newcommand{\otTete}{%
  {\otSemi\fontsize{7.5}{9}\selectfont\color{\otPartieCouleur}\otCaps[10]{Unit \otUniteNum}}%
  \hspace{0.7em}{\otMedium\fontsize{7.5}{9}\selectfont\color{otMuted}\enb{\otCaps[8]{\otUniteTitre}}}}
\newcommand{\otTeteRub}{{\otLight\fontsize{7}{9}\selectfont\color{otMuted}\otCaps[8]{\rightmark}}}
\newcommand{\otPied}{{\otLight\fontsize{7}{9}\selectfont\color{otMuted}%
  \otCaps[10]{OptiTAB · \otCollection\ · Tome \otTome\ · \otTomeTitre}}}
\newcommand{\otNumPage}{{\otSemi\fontsize{8.5}{10}\selectfont\color{otNavy}\thepage}}
\fancypagestyle{otUnite}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \fancyhead[LE]{\otTete}\fancyhead[RO]{\otTete}%
  \fancyhead[RE]{\otTeteRub}\fancyhead[LO]{\otTeteRub}%
  \fancyfoot[LE]{\otOnglet\otNumPage\hspace{1em}\otPied}%
  \fancyfoot[RO]{\otOnglet\otPied\hspace{1em}\otNumPage}}
\fancypagestyle{otOuverture}{%
  \fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[LE]{\otOnglet\otNumPage\hspace{1em}\otPied}%
  \fancyfoot[RO]{\otOnglet\otPied\hspace{1em}\otNumPage}}
% Pages liminaires et annexes : en-tête = titre de la section (\otEnTeteGauche)
\fancypagestyle{otAnnexe}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \fancyhead[LE,RO]{{\otSemi\fontsize{7.5}{9}\selectfont\color{otNavy}\otCaps[10]{\otEnTeteGauche}}}%
  \fancyhead[RE,LO]{\otTeteRub}%
  \fancyfoot[LE]{\otNumPage\hspace{1em}\otPied}%
  \fancyfoot[RO]{\otPied\hspace{1em}\otNumPage}}
\fancypagestyle{otFront}{%
  \fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[LE]{\otNumPage}\fancyfoot[RO]{\otNumPage}}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}}
\pagestyle{otFront}

% Page blanche de fin de section : page « Notes » lignée
\newcommand{\otPageNotes}{%
  \thispagestyle{otFront}%
