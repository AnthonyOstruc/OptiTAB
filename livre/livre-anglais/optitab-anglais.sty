%% ---------------------------------------------------------------------
%%  Onglet d'unité sur le bord extérieur
%% ---------------------------------------------------------------------
\newcommand{\otOnglet}{%
  \ifnum\otUniteNum>0\relax
  \begin{tikzpicture}[remember picture,overlay]
    \pgfmathsetmacro{\otY}{106+(\otUniteNum-1)*8.4}
    \ifodd\value{page}
      \fill[\otPartieCouleur] ([yshift=-\otY mm]current page.north east) rectangle ++(-7mm,-7.8mm);
      \node[text=white,font=\otSemi\fontsize{8}{9}\selectfont]
        at ([xshift=-3.5mm,yshift=-\otY mm-3.9mm]current page.north east) {\otUniteNum};
    \else
      \fill[\otPartieCouleur] ([yshift=-\otY mm]current page.north west) rectangle ++(7mm,-7.8mm);
      \node[text=white,font=\otSemi\fontsize{8}{9}\selectfont]
        at ([xshift=3.5mm,yshift=-\otY mm-3.9mm]current page.north west) {\otUniteNum};
    \fi
  \end{tikzpicture}\fi}

