    \node[fill=otNavy,rounded corners=1.6mm,inner xsep=2.6mm,inner ysep=1.6mm,text=white,
      font=\otSemi\fontsize{8.6}{10}\selectfont] (u) {\otCaps[12]{Chapter #1}};
    \node[anchor=base west,inner sep=0pt,font=\otSemi\fontsize{15}{18}\selectfont] (t) at ([xshift=3.5mm]u.base east) {#2};
  \end{tikzpicture}\hspace{4mm}{\color{otRule}\leaders\hrule height 0.6pt\hfill\kern0pt}\par\vspace{4mm}}
\NewDocumentEnvironment{corrige}{m}{% numéro d'exercice
