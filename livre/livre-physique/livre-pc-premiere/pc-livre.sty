%% Tableau d'avancement centré ; l'argument est le nombre d'espèces (colonnes de quantités de matière).
%% Lignes types : \tavEquation{...}, \tavTitres{n}, puis « état & avancement & n1 & n2 ... \\ »
\newenvironment{avancement}[1]{%
  \par\smallskip\noindent\hfill\begingroup\small\renewcommand{\arraystretch}{1.32}\setlength{\tabcolsep}{5.5pt}%
  \arrayrulecolor{otNavy!55}\begin{tabular}{@{}>{\otMedium\fontsize{8}{10}\selectfont\color{otNavy}}l c*{#1}{c}@{}}\toprule}
  {\bottomrule\end{tabular}\endgroup\hfill\null\par\smallskip}
\newcommand{\tavEquation}[1]{Équation & & #1 \\ \midrule}
\newcommand{\tavTitres}[1]{État & {\otMedium\fontsize{8}{10}\selectfont\color{otNavy}Avancement (mol)} &
  \multicolumn{#1}{c}{\otMedium\fontsize{8}{10}\selectfont\color{otNavy}Quantités de matière (mol)} \\ \midrule}

\endinput
