% Pastille numérotée
\newcommand{\otNumBox}[2][otNavy]{%
  \tikz[baseline=(n.base)]\node[fill=#1,rounded corners=1.6pt,inner sep=0pt,
    minimum width=7mm,minimum height=6.2mm,text=white,
    font=\otBold\fontsize{10}{10}\selectfont](n){#2};}
\newcommand{\otNumBoxPetit}[2][otNavy]{%
  \tikz[baseline=(n.base)]\node[fill=#1,rounded corners=1.2pt,inner sep=0pt,
    minimum width=6mm,minimum height=4.8mm,text=white,
    font=\otSemi\fontsize{7.5}{8}\selectfont](n){#2};}

% Difficulté : 1, 2 ou 3 points
\newcommand{\otDots}[2][otNavy]{%
  \begin{tikzpicture}[baseline=0pt]
    \foreach \i in {1,2,3}{%
      \ifnum\i>#2\relax
        \fill[otRule] (\i*2.4mm,0.62ex) circle (0.9mm);
      \else
        \fill[#1] (\i*2.4mm,0.62ex) circle (0.9mm);
      \fi}
  \end{tikzpicture}}

% Coche verte
\newcommand{\otCheck}[1][otGreen]{%
  \tikz[baseline=-0.62ex]{\fill[#1] (0,0) circle (1.95mm);
    \draw[white,line width=0.95pt,line cap=round,line join=round]
      (-0.9mm,0.05mm) -- (-0.25mm,-0.65mm) -- (0.95mm,0.75mm);}}

% Pastille numérotée ronde (mode d'emploi, conseils)
\newcommand{\otRond}[2][otGreen]{%
  \tikz[baseline=(r.base)]\node[circle,fill=#1,inner sep=0pt,minimum size=4.6mm,
    text=white,font=\otBold\fontsize{7.5}{8}\selectfont](r){#2};}

% Filet horizontal fin (remplit la ligne)
\newcommand{\otFilet}[1][otRule]{%
  {\color{#1}\leaders\hrule height 2.75pt depth -2.35pt\hskip 0pt plus 1filll}}

% Titre de page liminaire : \otPageTitre{titre}{sous-titre}
\newcommand{\otPageTitre}[2]{%
  \noindent{\otLight\fontsize{30}{34}\selectfont\color{otInk}#1}\par
  \if\relax\detokenize{#2}\relax\else
    \vspace{2mm}{\otLight\fontsize{10}{13}\selectfont\color{otMuted}#2\par}\fi
  \vspace{4mm}%
  \noindent{\color{\otAccent}\rule[0pt]{16mm}{1.3pt}}%
  {\color{otRule}\rule[0.45pt]{\dimexpr\linewidth-16mm\relax}{0.4pt}}\par
  \vspace{8mm}}

% Petit intertitre en capitales
\newcommand{\otIntertitre}[1]{%
  \par\noindent{\otSemi\fontsize{8}{10}\selectfont\color{\otAccent}\otCaps[14]{#1}}\par
  \vspace{2.5mm}}

