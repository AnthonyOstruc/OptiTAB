    \foreach \g/\id/\coul/\lib/\chs [count=\r] in {#1}{%
      \pgfmathsetmacro{\ry}{-1-\r*7.2-(\g-1)*3.2}
      \node[anchor=west,fill=\coul,rounded corners=1.2pt,minimum width=9.5mm,minimum height=4.6mm,
        inner sep=0pt,text=white,font=\otBold\fontsize{7}{8}\selectfont] at (0,\ry+3.3) {\id};
