\newcommand{\otAvatarVisage}[2]{% peau, couleur des traits
  \fill[#1!88!black] (-0.12,-0.62) rectangle (0.12,-0.3);
  \fill[#1] (-0.37,-0.01) ellipse (0.075 and 0.11);
  \fill[#1] (0.37,-0.01) ellipse (0.075 and 0.11);
  \fill[#1] (0,0.02) ellipse (0.355 and 0.41);
  \fill[#2] (-0.125,0.03) circle (0.036) (0.125,0.03) circle (0.036);
  \fill[otRed,opacity=0.18] (-0.2,-0.11) circle (0.07) (0.2,-0.11) circle (0.07);
  \draw[#2,line width=0.034*\otIcoU,line cap=round] (-0.1,-0.15) .. controls (-0.04,-0.21) and (0.04,-0.21) .. (0.1,-0.15);}
\newcommand{\otAvatarCorps}[1]{\fill[#1] (0,-1.28) ellipse (0.8 and 0.66);}
