  headheight=14pt,headsep=7mm,footskip=11mm]{geometry}

\RequirePackage[english,french]{babel}
\frenchsetup{StandardItemizeEnv=true,StandardEnumerateEnv=true,og=«,fg=»}
% \en{...} : mot anglais dans un texte français (italique, convention des mots étrangers)
% \enb{...} : texte anglais sans changement de style (dialogues, tableaux, titres)
\newcommand{\en}[1]{\foreignlanguage{english}{\textit{#1}}}
\newcommand{\enb}[1]{\foreignlanguage{english}{#1}}
\newenvironment{anglais}{\begin{otherlanguage}{english}}{\end{otherlanguage}}
% Cellules de tableau en anglais : >{\enOn}l<{\enOff}
\newcommand{\enOn}{\begin{otherlanguage*}{english}}
\newcommand{\enOff}{\end{otherlanguage*}}

