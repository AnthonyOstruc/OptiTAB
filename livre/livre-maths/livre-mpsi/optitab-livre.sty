        at (\otPlanL,\ry+3.3) {\ifcsname r@sujet-\id\endcsname p.\,\pageref{sujet-\id}\fi};}
    \draw[otMuted,line width=0.5pt,dash pattern=on 1.5pt off 1.5pt]
      ({\otPlanX+10*4.6},3) -- ({\otPlanX+10*4.6},-1-16*7.2-3*3.2);
  \end{tikzpicture}\par
  \vspace{4mm}
  {\otLight\fontsize{8.2}{11}\selectfont\color{otMuted}\noindent
  Le trait pointillé sépare les deux semestres. Bleu : devoirs surveillés ; vert : devoirs maison ;
  orange : examens ; rouge : sujets type concours.\par}}

