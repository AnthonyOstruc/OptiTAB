  \hspace{2.4mm}{\otSemi\fontsize{10.4}{13}\selectfont Your turn \csname otNumDe@\otCorPref\endcsname.#1}%
  \hfill{\otLight\fontsize{7}{9}\selectfont\color{otMuted}page~\pageref{atoi-\otCorPref-#1}}\par\nopagebreak\vspace{1.6mm}%
  \fontsize{10.4}{13.2}\selectfont}
