% \partieFiches{nom}{couleur} : à placer avant les fiches d'une partie (pas de page)
\newcommand{\partieFiches}[2]{%
  \gdef\otPartieNom{#1}\gdef\otPartieCouleur{#2}}

%% ---------------------------------------------------------------------
%%  Onglet de fiche sur le bord extérieur
%% ---------------------------------------------------------------------
\newcommand{\otOnglet}{%
  \ifnum\otFicheNum>0\relax
  \begin{tikzpicture}[remember picture,overlay]
    \pgfmathsetmacro{\otY}{70+(\otFicheNum-1)*9.3}
    \ifodd\value{page}
      \fill[\otPartieCouleur] ([yshift=-\otY mm]current page.north east) rectangle ++(-6.5mm,-8.6mm);
      \node[text=white,font=\otSemi\fontsize{7.5}{8}\selectfont]
        at ([xshift=-3.25mm,yshift=-\otY mm-4.3mm]current page.north east) {\otTwoDigits{\otFicheNum}};
    \else
      \fill[\otPartieCouleur] ([yshift=-\otY mm]current page.north west) rectangle ++(6.5mm,-8.6mm);
      \node[text=white,font=\otSemi\fontsize{7.5}{8}\selectfont]
        at ([xshift=3.25mm,yshift=-\otY mm-4.3mm]current page.north west) {\otTwoDigits{\otFicheNum}};
    \fi
  \end{tikzpicture}\fi}

