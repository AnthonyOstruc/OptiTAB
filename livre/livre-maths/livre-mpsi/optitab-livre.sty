        font=\otRegular\fontsize{6.6}{8}\selectfont] at (\cx,4.2) {\nom};
      \node[inner sep=0pt,text=otNavy,font=\otSemi\fontsize{6.6}{8}\selectfont] at (\cx,1.2) {\c};}
