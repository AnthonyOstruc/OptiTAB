      \pgfmathsetmacro{\aa}{atan(-(\yy-72)/25)}%
      \draw[white,opacity=0.4,line width=0.6pt,line cap=round]
        ({(\xx-2*cos(\aa))*1mm},{(\yy-2*sin(\aa))*1mm}) -- ({(\xx+2*cos(\aa))*1mm},{(\yy+2*sin(\aa))*1mm});}}
  \draw[white,opacity=0.55,line width=0.6pt,dash pattern=on 3pt off 2pt] (112mm,72mm) -- (210mm,72mm);
  \foreach \A in {14,30}{%
    \draw[white,opacity=0.6,line width=1.3pt,line cap=round]
      plot[domain=112:210,samples=100] ({\x*1mm},{(72+\A*exp(-(\x-112)/25))*1mm});}
