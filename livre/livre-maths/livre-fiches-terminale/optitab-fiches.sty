    coltext=white]
  \noindent{\otSemi\fontsize{7}{8}\selectfont\color{otGreen}\otCaps[12]{Check-list}}\hspace{2mm}%
  {\otSemi\fontsize{10.5}{12}\selectfont Je sais\ldots}\par\vspace{2mm}
  \begin{multicols}{2}\raggedcolumns
  \begin{itemize}[label={\tikz[baseline=-0.7ex]\draw[white,line width=0.6pt,rounded corners=0.6pt] (0,-1.5mm) rectangle (3mm,1.5mm);},
    leftmargin=6mm,itemsep=1.2mm,topsep=0pt]\fontsize{9.4}{11.6}\selectfont}
  {\end{itemize}\end{multicols}\end{tcolorbox}}

