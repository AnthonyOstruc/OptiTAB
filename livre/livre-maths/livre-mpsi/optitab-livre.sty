        \fill[otNavyTint,rounded corners=0.6pt] ({\otPlanX+(\c-1)*4.6+0.45},\ry+1.35) rectangle +(3.7,3.9);}
      \foreach \c in \chs{%
        \fill[\coul,rounded corners=0.6pt] ({\otPlanX+(\c-1)*4.6+0.45},\ry+1.35) rectangle +(3.7,3.9);}
