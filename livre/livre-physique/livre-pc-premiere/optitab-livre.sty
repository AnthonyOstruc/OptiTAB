\newcommand{\otDecocourbe}{%
  \otDecoGrille
  \draw[white,opacity=0.22,line width=0.5pt] (0,30mm) -- (210mm,30mm);
  \draw[white,opacity=0.55,line width=1.6pt,line cap=round]
