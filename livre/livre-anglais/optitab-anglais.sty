  \otAvatarCorps{otGreen}
  \fill[otGreen!70!white] (-0.16,-0.62) -- (0,-0.8) -- (0.16,-0.62) -- cycle;
  \otAvatarVisage{otPeau1}{otInk}
  \fill[otCheveuChatain] (-0.37,0.08) .. controls (-0.42,0.52) and (-0.05,0.6) .. (0.12,0.5)
    .. controls (0.3,0.48) and (0.42,0.32) .. (0.37,0.06) .. controls (0.3,0.26) and (0.12,0.31) .. (-0.06,0.3)
    .. controls (-0.22,0.28) and (-0.32,0.2) .. cycle;}
