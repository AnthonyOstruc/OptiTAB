\newcommand{\otTitreCode}{%
  \ifx\otCodeFichier\@empty
    \ifx\otCodeTitre\@empty\else\otTuile[3.6mm]{chevrons}{otNavy}\hspace{1.8mm}\otCodeTitre\hfill
      {\color{otMuted}\otCaps[10]{Python}}\fi
