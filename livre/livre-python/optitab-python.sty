%% ---------------------------------------------------------------------
\newcommand{\otSomRubrique}[2]{% titre, couleur
  \par\addvspace{5mm}\Needspace{6\baselineskip}\noindent
  {\otSemi\fontsize{7.2}{9}\selectfont\color{#2}\otCaps[12]{#1}}\par
  \vspace{1.2mm}{\color{#2}\hrule height 0.6pt}\vspace{2mm}}
\newcommand{\otSomLigne}[3]{% numéro ou icône, texte, étiquette de renvoi
  \par\noindent\makebox[10mm][l]{#1}%
  \parbox[b]{\dimexpr\linewidth-30mm\relax}{\RaggedRight #2}%
  {\color{otMuted!45}\leaders\hbox to 2.4mm{\hss.\hss}\hfill}%
  \makebox[11mm][r]{\ifcsname r@#3\endcsname{\otMedium\fontsize{9.4}{11}\selectfont\color{otNavy}\pageref{#3}}%
    \else{\otLight\fontsize{7.4}{9}\selectfont\color{otMuted}coming soon}\fi}\par\vspace{1.6mm}}
\newcommand{\otSomChap}[1]{%
  \otSomLigne{{\otBold\fontsize{12}{13}\selectfont\color{\otPlanP{coul}{\otPartieDe{#1}}}#1}}%
    {{\otSemi\fontsize{10.4}{12.4}\selectfont\otPlanU{titre}{#1}}\hspace{2.2mm}%
     {\otRegular\fontsize{9}{12.4}\selectfont\color{otMuted}\otPlanU{sous}{#1}}}{chapitre-#1}}
\newcommand{\otSomPartie}[1]{%
  \otSomRubrique{Part #1\enspace·\enspace\otPlanP{titre}{#1}\enspace{\otLight\otPlanP{en}{#1}}}{\otPlanP{coul}{#1}}%
  \foreach \u in {\otPlanP{de}{#1},...,\otPlanP{a}{#1}}{\otSomChap{\u}}%
  \otSomLigne{\otTuile[5mm]{fusee}{\otPlanP{coul}{#1}}}%
    {{\otSemi\fontsize{10}{12.4}\selectfont Project #1: \otPlanJ{titre}{#1}}\hspace{2.2mm}%
     {\otRegular\fontsize{9}{12.4}\selectfont\color{otMuted}\otPlanJ{sous}{#1}}}{projet-#1}%
  \otSomLigne{\otTuile[5mm]{coche}{\otPlanP{coul}{#1}}}%
    {{\otSemi\fontsize{10}{12.4}\selectfont Checkpoint #1}\hspace{2.2mm}%
     {\otRegular\fontsize{9}{12.4}\selectfont\color{otMuted}review and test of chapters \otPlanP{de}{#1} to \otPlanP{a}{#1}}}{bilan-#1}}
% Tableau des contenus d'une partie
\newcommand{\otPrgPartie}[1]{%
  \otPrgPrepare{#1}%
  \par\addvspace{4mm}\Needspace{6\baselineskip}\noindent
  \begin{tcolorbox}[enhanced,colback=\otPlanP{coul}{#1},colframe=\otPlanP{coul}{#1},arc=1.4mm,left=3mm,right=3mm,
    top=1.8mm,bottom=1.8mm,boxsep=0pt,before skip=0pt,after skip=1.5mm,coltext=white]
  {\otSemi\fontsize{7.4}{9}\selectfont\otCaps[12]{Part #1}}\hspace{2.5mm}{\otSemi\fontsize{10.5}{12}\selectfont\otPlanP{titre}{#1}}%
  \hspace{2mm}{\otLight\fontsize{9.5}{12}\selectfont\otPlanP{en}{#1}}
  \end{tcolorbox}
  \noindent{\renewcommand{\arraystretch}{1.25}\arrayrulecolor{otRule}%
  \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}p{32mm}*{4}{>{\RaggedRight\arraybackslash\fontsize{8.3}{10.2}\selectfont}X}@{}}
  \otTH{Chapter} & \otTH{Concepts} & \otTH{Python} & \otTH{Good habits} & \otTH{You'll build}\\\midrule
  \otPrgCorps
  \end{tabularx}}\par}
\newcommand{\otPrgCorps}{}
\newcommand{\otPrgPrepare}[1]{%
  \gdef\otPrgCorps{}%
  \foreach \u in {\otPlanP{de}{#1},...,\otPlanP{a}{#1}}{%
    \ifnum\u=\otPlanP{a}{#1}\relax
      \xdef\otPrgCorps{\unexpanded\expandafter{\otPrgCorps}\noexpand\otPrgLigne{\u}\noexpand\\\noexpand\bottomrule}%
    \else
      \xdef\otPrgCorps{\unexpanded\expandafter{\otPrgCorps}\noexpand\otPrgLigne{\u}\noexpand\\\noexpand\midrule}%
    \fi}}
\newcommand{\otPrgLigne}[1]{%
  {\otBold\fontsize{11}{12}\selectfont\color{\otPlanP{coul}{\otPartieDe{#1}}}#1}\enspace
  {\otSemi\fontsize{8.6}{10.4}\selectfont\otPlanU{titre}{#1}}\par
  {\fontsize{8.2}{10}\selectfont\color{otMuted}\otPlanU{sous}{#1}}
  & \otPlanU{concepts}{#1} & \otPlanU{python}{#1} & \otPlanU{habitudes}{#1} & \otPlanU{projet}{#1}}

