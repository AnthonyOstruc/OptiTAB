%% ---------------------------------------------------------------------
%%  Ouverture d'une fiche : bandeau pleine largeur en haut de page
%%  \fiche[décor]{numéro}{titre}{mots-clés}
%% ---------------------------------------------------------------------
\newcommand{\otDecoGrille}{%
  \draw[white,opacity=0.06,line width=0.3pt,step=6mm] (0,0) grid (210mm,64mm);}
\newcommand{\otDecoAucun}{\otDecoGrille}
\newsavebox{\otBoiteTitre}
% Décor « suites » : termes alternés qui se resserrent dans une bande autour de la limite
\newcommand{\otDecosuites}{%
  \otDecoGrille
  \fill[otGreen,opacity=0.16] (150mm,29mm) rectangle (210mm,39mm);
  \draw[otGreen,opacity=0.65,line width=0.5pt] (150mm,29mm) -- (210mm,29mm) (150mm,39mm) -- (210mm,39mm);
  \draw[white,opacity=0.5,line width=0.5pt,dash pattern=on 3pt off 2pt] (140mm,34mm) -- (210mm,34mm);
  \draw[white,opacity=0.3,line width=0.5pt] (140mm,6mm) -- (140mm,60mm);
  \foreach \k in {0,...,15}{%
    \pgfmathsetmacro{\yy}{34+22*0.78^\k*cos(180*\k)}
    \pgfmathsetmacro{\xx}{143+4*\k}
    \ifdim\yy pt<39pt\relax\ifdim\yy pt>29pt\relax
      \fill[otGreen] (\xx mm,\yy mm) circle (1.15mm);
    \else\fill[white,opacity=0.85] (\xx mm,\yy mm) circle (1.15mm);\fi
    \else\fill[white,opacity=0.85] (\xx mm,\yy mm) circle (1.15mm);\fi}
  \node[text=white,opacity=0.8,font=\otMedium\fontsize{9}{10}\selectfont] at (136mm,34mm) {$\ell$};}
\NewDocumentCommand{\fiche}{O{Aucun} m m m}{%
  \clearpage
  \gdef\otFicheNum{#2}\gdef\otFicheTitre{#3}%
  \setcounter{otsect}{0}%
  \thispagestyle{otOuverture}%
  \markboth{#3}{#3}%
  \phantomsection\label{fiche-#2}%
  \pdfbookmark[1]{Fiche \otTwoDigits{#2} — #3}{bm-fiche-#2}%
  \immediate\write\@auxout{\string\otFicheVue{#2}}%
  \sbox{\otBoiteTitre}{\color{white}\otSemi\fontsize{27}{30}\selectfont #3}%
  \ifdim\wd\otBoiteTitre>116mm
    \sbox{\otBoiteTitre}{\color{white}\otSemi\fontsize{21}{24}\selectfont #3}\fi
  \begin{tikzpicture}[remember picture,overlay]
    \begin{scope}[shift={([yshift=-64mm]current page.north west)}]
      \fill[otNavy] (0,0) rectangle (210mm,64mm);
      \begin{scope}\clip (0,0) rectangle (210mm,64mm);
        \csname otDeco#1\endcsname
      \end{scope}
      \fill[\otPartieCouleur] (0,0) rectangle (210mm,1.6mm);
      \node[anchor=west,fill=otGreen,rounded corners=1.6pt,inner xsep=2.2mm,inner ysep=1.4mm,
        text=white,font=\otSemi\fontsize{8}{9}\selectfont] (pill) at (19mm,50mm)
        {\otCaps[12]{Fiche \otTwoDigits{#2}}};
      \node[anchor=west,inner sep=0pt,text=white,opacity=0.8,
        font=\otMedium\fontsize{8}{9}\selectfont] at ([xshift=3.5mm]pill.east)
        {\otCaps[12]{\otPartieNom}};
      \node[anchor=base west,inner sep=0pt] at (18.3mm,30mm) {\usebox{\otBoiteTitre}};
      \node[anchor=north west,inner sep=0pt,text=white,opacity=0.75,text width=116mm,
        font=\otLight\fontsize{8.6}{11.5}\selectfont,align=left] at (19mm,22mm)
        {\hyphenpenalty=10000\exhyphenpenalty=10000 #4\par};
    \end{scope}
  \end{tikzpicture}%
  \vspace*{39mm}\par}

% Séparateur des mots-clés du bandeau (point de coupure de ligne autorisé après le point médian)
