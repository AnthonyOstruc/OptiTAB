%%  optitab-anglais.sty — Méthode d'anglais OptiTAB (collection en 5 tomes)
%%  Charte OptiTAB (Libertinus + Montserrat, bleu marine et vert).
%%  Compilation : LuaLaTeX, deux passes (voir README.md).
%%  Tout texte anglais passe par \enb{...} ou l'environnement anglais :
%%  la typographie française (espace avant ! ? : ;) ne s'y applique pas.
%% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{optitab-anglais}[2026/10/25 v1.0 Methode d'anglais OptiTAB]

\RequirePackage{iftex}
