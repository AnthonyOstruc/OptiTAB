% Carte d'objet (exercices) : \otCarteObjet{icône}{couleur}{nombre}{réponse}
\newcommand{\otCarteObjet}[4]{%
  \begin{tcolorbox}[enhanced,colback=otNavyTint,colframe=otNavyTint,arc=1.6mm,left=1.5mm,right=1.5mm,
    top=2.4mm,bottom=2.4mm,boxsep=0pt,halign=center]
  \begin{tikzpicture}
    \foreach \k in {1,...,#3}{\otDessinIcone{#1}{#2}{otNavyTint}{9mm}{({(\k-1)*10.5mm-(#3-1)*5.25mm},0)}}
    \path (-16mm,-5mm) rectangle (16mm,5mm);
  \end{tikzpicture}\par\vspace{2.4mm}
  \enb{\trou[36mm]{#4}}
  \end{tcolorbox}}
% Carte d'action (exercices) : \otCarteAction{perso}{icône}{couleur}{indication}{réponse}
\newcommand{\otCarteAction}[5]{%
  \begin{tcolorbox}[enhanced,colback=otNavyTint,colframe=otNavyTint,arc=1.6mm,left=1.5mm,right=1.5mm,
    top=2.4mm,bottom=2.4mm,boxsep=0pt,halign=center]
  \begin{tikzpicture}
    \otDessinAvatar{#1}{(0,0)}{8mm}{white}
    \fill[#3] (8.6mm,-5.2mm) circle (4.4mm);
    \draw[otNavyTint,line width=0.9pt] (8.6mm,-5.2mm) circle (4.4mm);
    \otDessinIcone{#2}{white}{#3}{5.2mm}{(8.6mm,-5.2mm)}
  \end{tikzpicture}\par\vspace{1.4mm}
  \otNomDit{#1}\par\vspace{0.4mm}
  {\fontsize{9.2}{11}\selectfont\color{otMuted}\enb{#4}}\par\vspace{2mm}
  \enb{\trou[46mm]{#5}}
  \end{tcolorbox}}
% Écran de téléphone avec des textos : \begin{otTextos}{contact} \otSms{g|d}{texte} … \end{otTextos}
\newenvironment{otTextos}[1]{%
  \begin{tcolorbox}[enhanced,width=96mm,center,colback=otNavy!9,colframe=otInk,boxrule=1.6pt,arc=5mm,
    left=3.5mm,right=3.5mm,top=1.5mm,bottom=3.5mm,
    overlay={\fill[otInk] ([yshift=-1.6mm]frame.north) ++(-7mm,0) rectangle ++(14mm,-1.4mm);}]
  \centering{\otSemi\fontsize{8.6}{10}\selectfont\color{otNavy}\rule{0pt}{4.6mm}#1}\par
  \vspace{0.6mm}{\color{otRule}\rule{\linewidth}{0.4pt}}\par\raggedright}
 {\end{tcolorbox}}
\tcbset{otSmsG/.style={colback=white,colframe=white,colupper=otInk},
  otSmsD/.style={colback=otNavy,colframe=otNavy,colupper=white}}
\newcommand{\otSms}[2]{%
  \par\vspace{1.6mm}\noindent
  \ifthenelse{\equal{#1}{d}}{\hfill\otSms@{otSmsD}{#2}}{\otSms@{otSmsG}{#2}}\par}
\newcommand{\otSms@}[2]{%
  \begin{tcolorbox}[enhanced,nobeforeafter,width=64mm,varwidth upper,boxsep=0pt,left=2.6mm,right=2.6mm,
    top=1.6mm,bottom=1.6mm,arc=3.2mm,boxrule=0pt,fontupper=\fontsize{10}{12.6}\selectfont,#1]
  \enb{#2}\end{tcolorbox}}
% Dessin d'une icône dans une figure TikZ : \otDessinIcone{clé}{couleur}{fond}{taille}{centre}
\newcommand{\otDessinIcone}[5]{%
  \pgfmathsetlength{\otIcoU}{#4}%
  \begin{scope}[shift={#5},x=\otIcoU,y=\otIcoU]\csname otIco@#1\endcsname{#2}{#3}\end{scope}}
% Icône seule dans le texte
\newcommand{\otIconeSeule}[3]{\tikz[baseline=0pt]{\path (0,0) rectangle (#3,#3);
  \otDessinIcone{#1}{#2}{white}{#3}{(0.5*#3,0.5*#3)}}}
% Tuile : carré arrondi coloré + icône blanche : \otTuile[taille]{clé}{couleur}
\NewDocumentCommand{\otTuile}{O{6mm} m m}{%
  \tikz[baseline={(0,0.28*#1)}]{\fill[#3,rounded corners=0.22*#1] (0,0) rectangle (#1,#1);
    \otDessinIcone{#2}{white}{#3}{0.6*#1}{(0.5*#1,0.5*#1)}}}

