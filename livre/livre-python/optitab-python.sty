      \fill[#4] (0,0) rectangle (210mm,297mm);
      \shade[bottom color=otNavyDark,top color=#4,opacity=0.9] (0,0) rectangle (210mm,140mm);
      \draw[white,opacity=0.05,line width=0.3pt,step=7mm] (0,0) grid (210mm,297mm);
      \node[anchor=north east,inner sep=0pt,text=white,opacity=0.1,font=\otBold\fontsize{300}{300}\selectfont]
        at (205mm,262mm) {#1};
      \node[anchor=base west,inner sep=0pt,text=otGreen,font=\otSemi\fontsize{11}{13}\selectfont]
        at (24mm,214mm) {\otCaps[22]{Part #1}};
      \node[anchor=base west,inner sep=0pt,text=white,font=\otBold\fontsize{40}{44}\selectfont]
        at (23mm,190mm) {#2};
      \node[anchor=base west,inner sep=0pt,text=white,opacity=0.75,font=\otLight\fontsize{20}{24}\selectfont]
        at (24mm,175mm) {#3};
      \fill[otGreen] (24mm,164mm) rectangle (54mm,165.4mm);
      \node[anchor=north west,inner sep=0pt,text width=125mm,text=white,opacity=0.9,
        font=\otRegular\fontsize{11}{15}\selectfont] at (24mm,154mm) {#5};
      \node[anchor=north west,inner sep=0pt,text width=150mm,text=white] at (24mm,112mm) {#6};
    \end{scope}
  \end{tikzpicture}%
  \clearpage}

%% ---------------------------------------------------------------------
%%  Plan du tome (tome-N/plan.tex)
%%  \planPartie{n}{titre}{accroche}{couleur}{de}{à}{texte}
%%  \planChapitre{n}{titre}{sous-titre}{concepts}{python}{habitudes}{réalisation}
%%  \planProjet{n}{titre}{sous-titre}
%% ---------------------------------------------------------------------
\newcommand{\otPlanNbParties}{0}
\newcommand{\planPartie}[7]{%
  \xdef\otPlanNbParties{#1}%
  \expandafter\gdef\csname otPlanP@titre@#1\endcsname{#2}%
  \expandafter\gdef\csname otPlanP@en@#1\endcsname{#3}%
  \expandafter\gdef\csname otPlanP@coul@#1\endcsname{#4}%
  \expandafter\gdef\csname otPlanP@de@#1\endcsname{#5}%
  \expandafter\gdef\csname otPlanP@a@#1\endcsname{#6}%
  \expandafter\gdef\csname otPlanP@texte@#1\endcsname{#7}%
  \foreach \k in {#5,...,#6}{\expandafter\xdef\csname otPlanC@partie@\k\endcsname{#1}}}
\newcommand{\planChapitre}[7]{%
  \expandafter\gdef\csname otPlanU@titre@#1\endcsname{#2}%
  \expandafter\gdef\csname otPlanU@sous@#1\endcsname{#3}%
  \expandafter\gdef\csname otPlanU@concepts@#1\endcsname{#4}%
  \expandafter\gdef\csname otPlanU@python@#1\endcsname{#5}%
  \expandafter\gdef\csname otPlanU@habitudes@#1\endcsname{#6}%
  \expandafter\gdef\csname otPlanU@projet@#1\endcsname{#7}}
\newcommand{\planProjet}[3]{%
  \expandafter\gdef\csname otPlanJ@titre@#1\endcsname{#2}%
  \expandafter\gdef\csname otPlanJ@sous@#1\endcsname{#3}}
\newcommand{\otPlanP}[2]{\csname otPlanP@#1@#2\endcsname}
\newcommand{\otPlanU}[2]{\csname otPlanU@#1@#2\endcsname}
\newcommand{\otPlanJ}[2]{\csname otPlanJ@#1@#2\endcsname}
\newcommand{\otPartieDe}[1]{\csname otPlanC@partie@#1\endcsname}
% Ouverture de partie à partir du plan
\newcommand{\partieDuPlan}[1]{%
  \partie{#1}{\otPlanP{titre}{#1}}{\otPlanP{en}{#1}}{\otPlanP{coul}{#1}}{\otPlanP{texte}{#1}}%
    {\foreach \u in {\otPlanP{de}{#1},...,\otPlanP{a}{#1}}{\otPartieChap{\u}{\otPlanU{titre}{\u}}{\otPlanU{sous}{\u}}}%
     \otPartieLigne{fusee}{Project #1: \otPlanJ{titre}{#1}}{\otPlanJ{sous}{#1}}{projet-#1}%
     \otPartieLigne{coche}{Checkpoint #1}{Review and test of chapters \otPlanP{de}{#1} to \otPlanP{a}{#1}}{bilan-#1}}}
\newcommand{\otPartieLigne}[4]{% icône, titre, sous-titre, étiquette
  \noindent\makebox[16mm][l]{\otTuile[7.5mm]{#1}{otGreen}}%
  \parbox[b]{108mm}{{\otSemi\fontsize{13}{15}\selectfont #2}\par\vspace{0.6mm}
    {\otLight\fontsize{10}{12}\selectfont\color{white}#3}}\hfill
  \ifcsname r@#4\endcsname{\otMedium\fontsize{10}{12}\selectfont p.~\pageref{#4}}%
  \else{\otLight\fontsize{8.5}{10}\selectfont coming soon}\fi\par\vspace{5mm}}
\newcommand{\otPartieChap}[3]{%
  \noindent\makebox[16mm][l]{{\otBold\fontsize{20}{22}\selectfont\color{otGreen}#1}}%
  \parbox[b]{108mm}{{\otSemi\fontsize{13}{15}\selectfont #2}\par\vspace{0.6mm}
    {\otLight\fontsize{10}{12}\selectfont\color{white}#3}}\hfill
  \ifcsname otChapVu@#1\endcsname{\otMedium\fontsize{10}{12}\selectfont p.~\pageref{chapitre-#1}}%
  \else{\otLight\fontsize{8.5}{10}\selectfont coming soon}\fi
  \par\vspace{5mm}}

