\newcommand{\otCheck}[1][otGreen]{%
  \tikz[baseline=-0.62ex]{\fill[#1] (0,0) circle (1.75mm);
    \draw[white,line width=0.85pt,line cap=round,line join=round]
      (-0.8mm,0.05mm) -- (-0.22mm,-0.6mm) -- (0.85mm,0.7mm);}}
\newcommand{\otCroix}[1][otRed]{%
  \tikz[baseline=-0.62ex]{\fill[#1] (0,0) circle (1.75mm);
    \draw[white,line width=0.85pt,line cap=round] (-0.65mm,-0.65mm) -- (0.65mm,0.65mm) (-0.65mm,0.65mm) -- (0.65mm,-0.65mm);}}
\newcommand{\otCase}{\tikz[baseline=-0.75ex]\draw[otNavy,line width=0.6pt,rounded corners=0.6pt] (0,-1.5mm) rectangle (3mm,1.5mm);}
\newcommand{\otRond}{\tikz[baseline=-0.75ex]\draw[otNavy,line width=0.6pt] (0,0) circle (1.5mm);}
\newcommand{\otEtiquette}[2]{{\otSemi\fontsize{6.8}{8}\selectfont\color{#1}\otCaps[11]{#2}}}
\newcommand{\cle}[1]{\textbf{#1}}
% Mise en évidence d'une structure dans un texte anglais
\newcommand{\hl}[1]{\highLight[otGreen!24]{#1}}
% Registre de langue : \registre{familier}
\newcommand{\registre}[1]{\tikz[baseline=(r.base)]\node[draw=otMuted!60,line width=0.4pt,rounded corners=1.2mm,
  inner xsep=1.2mm,inner ysep=0.5mm,text=otMuted,font=\otMedium\fontsize{6.2}{7}\selectfont] (r) {#1};}
% Numéro de note dans un dialogue : \note{1}
\newcommand{\note}[1]{\,\raisebox{0.9ex}{\tikz\node[circle,fill=otOrange,text=white,inner sep=0pt,minimum size=3.3mm,
  font=\otBold\fontsize{6}{6}\selectfont]{#1};}}
\newcommand{\otNumNote}[1]{\tikz[baseline=(n.base)]\node[circle,fill=otOrange,text=white,inner sep=0pt,minimum size=4.2mm,
  font=\otBold\fontsize{7}{7}\selectfont] (n) {#1};}
% Phrase d'exemple : \exen{anglais}{français}
\newcommand{\exen}[2]{\par\noindent\hangindent=4.5mm\makebox[4.5mm][l]{\color{otGreen}\small\textbullet}%
  \enb{#1}\if\relax\detokenize{#2}\relax\else\hspace{0.6em}{\color{otMuted}\itshape\fontsize{9.6}{12}\selectfont#2}\fi\par\vspace{1mm}}
% Erreur / forme correcte : \faux{...} \juste{...}
\newcommand{\faux}[1]{\par\noindent\otCroix\hspace{2mm}{\color{otRedDark}\enb{\strikeThrough{#1}}}\par\vspace{1mm}}
\newcommand{\juste}[1]{\par\noindent\otCheck\hspace{2mm}\enb{#1}\par\vspace{1mm}}
\newcommand{\fauxjuste}[2]{\par\noindent\otCroix\hspace{2mm}{\color{otRedDark}\enb{\strikeThrough{#1}}}%
  \hspace{6mm}\otCheck\hspace{2mm}\enb{#2}\par\vspace{1.2mm}}
% Intertitre
\newcommand{\otIntertitre}[2][otNavy]{\par\addvspace{3mm}\needspace{5\baselineskip}\noindent
  {\otSemi\fontsize{7.6}{9}\selectfont\color{#1}\otCaps[12]{#2}}\par\nopagebreak\vspace{1.6mm}}

%% ---------------------------------------------------------------------
%%  Rubriques d'une unité : \rubrique{clé}{titre français}
%%  clés : ecouter, mots, grammaire, sons, culture, pratique, bilan
%% ---------------------------------------------------------------------
\newcommand{\otDefRubrique}[4]{% clé, couleur, libellé anglais, icône
  \expandafter\gdef\csname otRub@#1@coul\endcsname{#2}%
  \expandafter\gdef\csname otRub@#1@en\endcsname{#3}%
  \expandafter\gdef\csname otRub@#1@ico\endcsname{#4}}
\otDefRubrique{ecouter}{otNavy}{Listen}{casque}
\otDefRubrique{mots}{otGreenDark}{Words}{bulle}
\otDefRubrique{grammaire}{otViolet}{Grammar}{blocs}
\otDefRubrique{sons}{otOrangeDark}{Sounds}{sons}
\otDefRubrique{culture}{otTeal}{Culture}{globe}
\otDefRubrique{pratique}{otNavy}{Practice}{crayon}
\otDefRubrique{bilan}{otGreenDark}{Check}{coche}
\newcommand{\otRubCoul}[1]{\csname otRub@#1@coul\endcsname}
\newcommand{\otRubEN}[1]{\csname otRub@#1@en\endcsname}
\newcommand{\otRubIco}[1]{\csname otRub@#1@ico\endcsname}
\NewDocumentCommand{\rubrique}{o m m}{% [texte court], clé, titre
  \def\otTmpCle{#2}\def\otTmpBilan{bilan}%
  \ifx\otTmpCle\otTmpBilan\clearpage\fi% le bilan d'unité commence toujours une page
  \par\addvspace{7mm}\needspace{16\baselineskip}%
  % le titre « Les mots de l'unité » ne reste jamais seul en bas de page, loin de son tableau
  \def\otTmpMots{mots}\ifx\otTmpCle\otTmpMots\needspace{30\baselineskip}\fi
  \refstepcounter{otrub}%
  \IfNoValueTF{#1}{\markright{\otRubEN{#2}\ · #3}%
    \phantomsection\pdfbookmark[2]{\theotrub. #3}{bm-\otPref-r\theotrub}}%
   {\markright{\otRubEN{#2}\ · #1}%
    \phantomsection\pdfbookmark[2]{\theotrub. #1}{bm-\otPref-r\theotrub}}%
  \noindent
  \begin{tikzpicture}[baseline=(titre.base)]
    \fill[\otRubCoul{#2},rounded corners=2.4mm] (0,-5.5mm) rectangle (11mm,5.5mm);
    \otDessinIcone{\otRubIco{#2}}{white}{\otRubCoul{#2}}{6.6mm}{(5.5mm,0)}
    \node[anchor=south west,inner sep=0pt,text=\otRubCoul{#2},font=\otSemi\fontsize{7.4}{9}\selectfont]
      at (14.5mm,1.2mm) {\otCaps[14]{\theotrub\enspace·\enspace\otRubEN{#2}}};
    \node[anchor=base west,inner sep=0pt,text=otInk,font=\otSemi\fontsize{16.5}{19}\selectfont] (titre)
      at (14.3mm,-4.6mm) {#3};
  \end{tikzpicture}%
  \hspace{4mm}{\color{\otRubCoul{#2}!30}\leaders\hrule height 0.6pt\hfill\kern0pt}%
  \par\nopagebreak\vspace{4.5mm}}

