%% =====================================================================
%%  pc-livre.sty — Compléments physique-chimie du livre OptiTAB
%%  Unités, chimie (équations, schémas de Lewis), verrerie et montages,
%%  documents d'exercices, figures d'énoncé et de corrigé, défis.
%% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pc-livre}[2026/10/21 v1.0 Complements physique-chimie OptiTAB]

%% ---------------------------------------------------------------------
%%  Unités et nombres (conventions françaises)
%% ---------------------------------------------------------------------
\RequirePackage{siunitx}
% Le \nobreak après chaque opérateur empêche de couper une grandeur en fin de ligne (« 2,0 × | 10⁻³ », « mol · | L⁻¹ »).
\sisetup{locale=FR,per-mode=power,inter-unit-product=\ensuremath{{}\cdot\nobreak{}},
  exponent-product=\times\nobreak,group-minimum-digits=5,uncertainty-mode=separate}
\newcommand{\molL}{\unit{mol.L^{-1}}}
\newcommand{\gL}{\unit{g.L^{-1}}}
\newcommand{\gmol}{\unit{g.mol^{-1}}}
\newcommand{\cst}{c^{\circ}}
\newcommand{\pH}{\mathrm{pH}}
\newcommand{\pKa}{\mathrm{p}K_{\mathrm{A}}}
\newcommand{\conc}[1]{[\mathrm{#1}]}
% Concentration en ion oxonium, écriture usuelle
\newcommand{\hho}{[\ce{H3O+}]}

%% ---------------------------------------------------------------------
%%  Chimie : équations (mhchem) et formules (chemfig)
%% ---------------------------------------------------------------------
\RequirePackage[version=4]{mhchem}
% Signe moins des charges et des liaisons : un vrai tiret dans toutes les polices
\mhchemoptions{textminus={\hspace{0.3ex}\textendash\hspace{0.3ex}}}
\RequirePackage{chemfig}
\setchemfig{atom sep=2.05em,bond offset=1.4pt,double bond sep=2.6pt,
  bond style={line width=0.6pt,otInk},atom style={text=otInk}}
\setcharge{extra sep=1.1pt,"length=1.45ex,|style={otInk,line width=0.75pt}}
% Charge formelle entourée, à la française
\newcommand{\cplus}{\scalebox{0.82}{$\oplus$}}
\newcommand{\cmoins}{\scalebox{0.82}{$\ominus$}}
% Mise en valeur d'un groupe caractéristique dans un schéma (cadre vert)
\tikzset{pcGroupe/.style={draw=otGreenDark,line width=0.7pt,rounded corners=1.6mm,
  dash pattern=on 2.4pt off 1.4pt}}
% Flèche courbe d'un mouvement de doublet (du doublet vers l'atome) et charges partielles
\tikzset{pcCourbe/.style={draw=otRed!85!black,line width=0.7pt,-{Stealth[length=1.9mm,width=1.5mm]},
  shorten <=0.6pt,shorten >=1pt},
  pcDelta/.style={font=\otMedium\fontsize{7}{8}\selectfont,inner sep=0.5pt}}
\setchemfig{arrow style={otInk,line width=0.6pt},arrow head={-{Stealth[length=2mm]}},
  scheme debug=false}
% Grandeur algébrique d'optique : \alg{OA} donne OA surmonté d'une barre
\newcommand{\alg}[1]{\overline{\mathrm{#1}}}
% Charges partielles : \dplus, \dmoins (dans un \chemmove ou un nœud TikZ)
\newcommand{\dplus}{\textcolor{otRed!80!black}{$\delta^{+}$}}
\newcommand{\dmoins}{\textcolor{otNavy}{$\delta^{-}$}}

%% ---------------------------------------------------------------------
%%  Rubriques à la suite : on ne change de page que si la place manque
%%  (le test de \needspace ajoute une pénalité qui provoquait des pages à moitié vides)
%% ---------------------------------------------------------------------
\newcommand{\otBesoinPlaceStrict}[1]{%
  \par\begingroup\setlength{\dimen@}{#1}\dimen@ii\pagegoal\advance\dimen@ii-\pagetotal
    \ifdim\dimen@>\dimen@ii\ifdim\dimen@ii>\z@\vfil\fi\break\fi
  \endgroup}
\patchcmd{\rubrique}{\otBesoinPlace{10\baselineskip}}{\otBesoinPlaceStrict{12\baselineskip}}{}
  {\PackageError{pc-livre}{Impossible d'adapter la commande rubrique}{}}

%% ---------------------------------------------------------------------
%%  Encadrés complémentaires de la synthèse de cours
%% ---------------------------------------------------------------------
