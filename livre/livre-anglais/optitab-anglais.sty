  \parbox[t]{\dimexpr\linewidth-\otDitNom-2mm\relax}{\enb{\fontsize{10.6}{13.2}\selectfont #2}}\par\vspace{1.2mm}}

%% ---------------------------------------------------------------------
%%  Pages liminaires
%% ---------------------------------------------------------------------
\newcommand{\otPageTitre}[2]{%
  \noindent{\otLight\fontsize{30}{34}\selectfont\color{otInk}#1}\par\vspace{2.2mm}
  \if\relax\detokenize{#2}\relax\else
    \noindent{\otRegular\fontsize{10.6}{13.4}\selectfont\color{otMuted}#2}\par\vspace{2.2mm}\fi
  \noindent{\color{otNavy}\rule{16mm}{1.3pt}}%
  {\color{otRule}\rule[0.45pt]{\dimexpr\linewidth-16mm\relax}{0.4pt}}\par\vspace{8mm}}
\NewDocumentCommand{\liminaire}{m m m}{% clé, titre, sous-titre
  \clearpage\gdef\otEnTeteGauche{#2}\markright{#3}%
  \thispagestyle{otFront}%
  \phantomsection\label{lim-#1}\pdfbookmark[0]{#2}{bm-lim-#1}%
  \otPageTitre{#2}{#3}}

%% ---------------------------------------------------------------------
%%  Petits dessins réutilisables
%% ---------------------------------------------------------------------
% Horloge : \otDessinHorloge{centre}{rayon}{heures}{minutes}{couleur}
\newcommand{\otDessinHorloge}[5]{%
  \begin{scope}[shift={#1}]
    \fill[white] (0,0) circle (#2);
    \draw[#5,line width=0.9pt] (0,0) circle (#2);
    \foreach \k in {1,2,4,5,7,8,10,11}{\draw[#5!70,line width=0.45pt] (90-30*\k:0.8*#2) -- (90-30*\k:0.93*#2);}
    \foreach \k in {0,3,6,9}{\draw[#5,line width=0.9pt] (90-30*\k:0.74*#2) -- (90-30*\k:0.93*#2);}
    \pgfmathsetmacro{\otAngH}{90-30*(mod(#3,12)+#4/60)}
    \pgfmathsetmacro{\otAngM}{90-6*#4}
    \draw[otInk,line width=1.5pt,line cap=round] (0,0) -- (\otAngH:0.5*#2);
    \draw[otInk,line width=0.95pt,line cap=round] (0,0) -- (\otAngM:0.74*#2);
    \fill[#5] (0,0) circle (0.07*#2);
  \end{scope}}
\newcommand{\otIco@soleil}[2]{%
  \fill[#1] (0,0) circle (0.22);
  \foreach \a in {0,45,...,315}{\draw[#1,line width=0.08*\otIcoU,line cap=round] (\a:0.32) -- (\a:0.46);}}
\newcommand{\otIco@lune}[2]{%
  \fill[#1] (0,0) circle (0.4);
  \fill[#2] (0.17,0.12) circle (0.34);}
% Météo : nuage, pluie, neige, vent, brouillard
\newcommand{\otIco@nuage}[2]{%
  \fill[#1] (-0.2,-0.02) circle (0.2) (0.06,0.1) circle (0.26) (0.28,-0.04) circle (0.17);
  \fill[#1,rounded corners=0.1*\otIcoU] (-0.4,-0.22) rectangle (0.45,0.02);}
\newcommand{\otIco@pluie}[2]{%
  \begin{scope}[yshift=0.14*\otIcoU]\otIco@nuage{#1}{#2}\end{scope}
  \foreach \x in {-0.22,0,0.22}{\draw[#1,line width=0.07*\otIcoU,line cap=round] (\x+0.04,-0.2) -- (\x-0.04,-0.42);}}
\newcommand{\otIco@neige}[2]{%
  \foreach \a in {0,60,120}{\draw[#1,line width=0.07*\otIcoU,line cap=round] (\a:0.44) -- (\a+180:0.44);}
  \foreach \a in {0,60,...,300}{\draw[#1,line width=0.06*\otIcoU,line cap=round]
    (\a:0.25) -- ++(\a+45:0.13) (\a:0.25) -- ++(\a-45:0.13);}}
\newcommand{\otIco@vent}[2]{%
  \draw[#1,line width=0.075*\otIcoU,line cap=round] (-0.44,0.16) -- (0.2,0.16) arc[start angle=-90,end angle=135,radius=0.13];
  \draw[#1,line width=0.075*\otIcoU,line cap=round] (-0.44,-0.02) -- (0.34,-0.02);
  \draw[#1,line width=0.075*\otIcoU,line cap=round] (-0.3,-0.2) -- (0.12,-0.2) arc[start angle=90,end angle=-135,radius=0.12];}
\newcommand{\otIco@brouillard}[2]{%
  \begin{scope}[yshift=0.17*\otIcoU,scale=0.85]\otIco@nuage{#1}{#2}\end{scope}
  \draw[#1,line width=0.07*\otIcoU,line cap=round] (-0.42,-0.2) -- (0.3,-0.2) (-0.28,-0.36) -- (0.42,-0.36);}
% Prévisions sur plusieurs jours : \otPrevision{jour/icône/couleur/°F/°C, …}
\newcommand{\otPrevision}[1]{%
  \begin{tcolorbox}[enhanced,colback=otNavyTint,colframe=otNavyTint,arc=1.6mm,left=2mm,right=2mm,
    top=2.6mm,bottom=2.6mm,boxsep=0pt,halign=center]
  \begin{tikzpicture}
    \foreach \j/\i/\c/\f/\cc [count=\k] in {#1}{%
      \begin{scope}[shift={(\k*30mm,0)}]
        \node[font=\otSemi\fontsize{8.4}{10}\selectfont,text=otNavy] at (0,11mm) {\enb{\otCaps[10]{\j}}};
        \otDessinIcone{\i}{\c}{otNavyTint}{11mm}{(0,1.5mm)}
        \node[font=\otBold\fontsize{12}{14}\selectfont,text=otInk] at (0,-8mm) {\f\,°F};
        \node[font=\fontsize{8.4}{10}\selectfont,text=otMuted] at (0,-12.6mm) {\cc\,°C};
      \end{scope}}
  \end{tikzpicture}
  \end{tcolorbox}}
% Carte horaire : \otCarteHeure{h}{min}{heure affichée}{situation}{soleil|lune}{réponse}
\newcommand{\otCarteHeure}[6]{%
  \begin{tcolorbox}[enhanced,colback=otNavyTint,colframe=otNavyTint,arc=1.6mm,left=2mm,right=2mm,
    top=2.4mm,bottom=2.4mm,boxsep=0pt,halign=center]
  \begin{tikzpicture}
    \otDessinHorloge{(0,0)}{8mm}{#1}{#2}{otNavy}
    \otDessinIcone{#5}{otOrangeDark}{otNavyTint}{5mm}{(11mm,6mm)}
  \end{tikzpicture}\par\vspace{1.4mm}
  {\otSemi\fontsize{9.6}{11}\selectfont #3}\par\vspace{0.8mm}
  {\fontsize{9.2}{11}\selectfont #4\par}\vspace{2.6mm}
  \enb{\trou[30mm]{#6}}
  \end{tcolorbox}}
% Prépositions de lieu : \otDessinPrepo{in|on|under|nextto|behind|infront|between}
\newcommand{\otBoite}[1]{% centre
  \begin{scope}[shift={#1}]
    \fill[otNavy!55] (-6mm,6mm) -- (-3mm,9mm) -- (9mm,9mm) -- (6mm,6mm) -- cycle;
    \fill[otNavy!75] (6mm,-6mm) -- (9mm,-3mm) -- (9mm,9mm) -- (6mm,6mm) -- cycle;
    \fill[otNavy!35] (-6mm,-6mm) rectangle (6mm,6mm);
  \end{scope}}
\newcommand{\otBalle}[1]{\shade[ball color=otRed] #1 circle (3mm);}
\newcommand{\otDessinPrepo}[1]{%
  \begin{tikzpicture}
    \path (-15mm,-9mm) rectangle (15mm,14mm);
    \draw[otMuted!50,line width=0.5pt] (-15mm,-6mm) -- (15mm,-6mm);
    \def\otTmpP{#1}%
    \ifthenelse{\equal{#1}{on}}{\otBoite{(0,0)}\otBalle{(1.5mm,10.4mm)}}{}%
    \ifthenelse{\equal{#1}{nextto}}{\otBoite{(-3mm,0)}\otBalle{(11mm,-3mm)}}{}%
    \ifthenelse{\equal{#1}{behind}}{\otBalle{(4mm,9mm)}\otBoite{(0,0)}}{}%
    \ifthenelse{\equal{#1}{infront}}{\otBoite{(0,1mm)}\otBalle{(-1mm,-3mm)}}{}%
    \ifthenelse{\equal{#1}{in}}{%
      \fill[otNavy!55] (-6mm,6mm) -- (-3mm,9mm) -- (9mm,9mm) -- (6mm,6mm) -- cycle;
      \fill[otNavy!20] (-5mm,6.3mm) -- (-2.6mm,8.6mm) -- (8.3mm,8.6mm) -- (5.7mm,6.3mm) -- cycle;
      \fill[otNavy!75] (6mm,-6mm) -- (9mm,-3mm) -- (9mm,9mm) -- (6mm,6mm) -- cycle;
      \otBalle{(1mm,4mm)}
      \fill[otNavy!35,opacity=0.55] (-6mm,-6mm) rectangle (6mm,6mm);
      \draw[otNavy!60,line width=0.4pt] (-6mm,-6mm) rectangle (6mm,6mm);}{}%
    \ifthenelse{\equal{#1}{under}}{%
      \fill[otOrangeDark!70] (-11mm,3mm) rectangle (11mm,5.5mm);
      \fill[otOrangeDark!55] (-9.5mm,-6mm) rectangle (-7.5mm,3mm) (7.5mm,-6mm) rectangle (9.5mm,3mm);
      \otBalle{(0,-3mm)}}{}%
    \ifthenelse{\equal{#1}{between}}{%
      \begin{scope}[scale=0.62]\otBoite{(-14mm,-3.6mm)}\otBoite{(13mm,-3.6mm)}\end{scope}
      \otBalle{(0,-3mm)}}{}%
  \end{tikzpicture}}
% Carte de préposition (exercices) : \otCartePrepo{type}{début}{réponse}{fin}
\newcommand{\otCartePrepo}[4]{%
  \begin{tcolorbox}[enhanced,colback=otNavyTint,colframe=otNavyTint,arc=1.6mm,left=1.5mm,right=1.5mm,
    top=2mm,bottom=2.4mm,boxsep=0pt,halign=center]
  \otDessinPrepo{#1}\par\vspace{1.6mm}
  {\fontsize{10}{12}\selectfont\enb{#2 \trou[17mm]{#3} #4}}
  \end{tcolorbox}}
% Niveau en étoiles : \otEtoiles{n} (sur 3)
\newcommand{\otEtoiles}[1]{\tikz[baseline=-0.7ex]{\foreach \k in {1,2,3}{%
  \ifnum\k>#1\relax\otDessinIcone{etoile}{otRule}{white}{3.4mm}{(\k*3.8mm,0)}%
  \else\otDessinIcone{etoile}{otOrange}{white}{3.4mm}{(\k*3.8mm,0)}\fi}}}
% Étiquette-mot (exercices de remise en ordre) : \etiq{word}
\newcommand{\etiq}[1]{\tikz[baseline=(e.base)]\node[draw=otNavy!40,fill=otNavyTint,line width=0.5pt,rounded corners=1.4mm,
  inner xsep=2mm,inner ysep=1.1mm,font=\fontsize{10.4}{12}\selectfont] (e) {\enb{#1}};}
% Main ouverte (test du souffle) : \otDessinMain{position}{échelle}
\newcommand{\otDessinMain}[2]{%
  \begin{scope}[shift={#1},x=#2,y=#2]
    \foreach \x/\h in {-0.33/0.62,-0.11/0.72,0.11/0.7,0.33/0.58}{%
      \fill[otPeau1,draw=otPeau3,line width=0.5pt,rounded corners=0.9mm] (\x-0.1,0) rectangle (\x+0.1,\h);}
    \fill[otPeau1,draw=otPeau3,line width=0.5pt,rounded corners=1.2mm,rotate around={-38:(-0.42,-0.42)}]
      (-0.52,-0.42) rectangle (-0.32,0.12);
    \fill[otPeau1,draw=otPeau3,line width=0.5pt,rounded corners=2.4mm] (-0.45,-0.75) rectangle (0.45,0.12);
    \fill[otPeau1] (-0.4,-0.05) rectangle (0.4,0.16);
  \end{scope}}

%% ---------------------------------------------------------------------
%%  Guide de prononciation : \begin{tableausons}{piste}{titre}
%%    \son{symbole}{mot}{phonétique}{explication}
%% ---------------------------------------------------------------------
\NewDocumentEnvironment{tableausons}{m m}{%
  \par\needspace{14\baselineskip}%
  \begin{tcolorbox}[enhanced,breakable,colback=white,colframe=otOrange!45,boxrule=0.6pt,arc=1.8mm,
    left=0mm,right=0mm,top=3mm,bottom=2mm,boxsep=0pt,before skip=3mm,after skip=3mm]
  \hspace*{4.5mm}\begin{minipage}[t]{\dimexpr\linewidth-36mm\relax}
    \otEtiquette{otOrangeDark}{Écoutez et répétez}\par\vspace{1.2mm}
    {\otSemi\fontsize{13}{16}\selectfont\color{otInk}#2}\par\vspace{1.4mm}
    {\fontsize{9.8}{12.4}\selectfont\color{otMuted}La voix lit chaque mot exemple ; répétez-le pendant la pause.}
  \end{minipage}\hfill\begin{minipage}[t]{22mm}\raggedleft\vspace{-1mm}\qrpiste[13.5mm]{#1}{}\end{minipage}\hspace*{4.5mm}\par
  \vspace{2mm}\setcounter{otmot}{0}}
  {\par\vspace{1mm}\end{tcolorbox}}
\newcommand{\son}[4]{%
  \stepcounter{otmot}%
  \ifodd\value{otmot}\def\otCoulLigne{otOrangeTint!55}\else\def\otCoulLigne{white}\fi
  \par\noindent\begingroup\setlength{\fboxsep}{0pt}%
  \colorbox{\otCoulLigne}{\parbox{\linewidth}{\vspace{1.1mm}\hspace*{4.5mm}%
    \parbox[c]{14mm}{\centering{\otIPAfont\fontsize{15}{16}\selectfont\color{otOrangeDark}#1}}%
    \parbox[c]{38mm}{\enb{\fontsize{11}{13}\selectfont\textbf{#2}}\enspace\ipa{#3}}%
    \parbox[c]{\dimexpr\linewidth-61mm\relax}{\RaggedRight\fontsize{9.6}{11.8}\selectfont #4}\par\vspace{1.1mm}}}%
  \endgroup\par}
\newcommand{\sonsCategorie}[1]{\par\addvspace{2mm}\noindent\hspace*{4.5mm}%
  {\otSemi\fontsize{7.4}{9}\selectfont\color{otOrangeDark}\otCaps[12]{#1}}\hspace{2.5mm}%
  {\color{otOrange!30}\leaders\hrule height 0.5pt\hfill\kern4.5mm}\par\nopagebreak\vspace{1.2mm}\setcounter{otmot}{0}}

%% ---------------------------------------------------------------------
%%  Sommaire et programme (données du plan)
%% ---------------------------------------------------------------------
\newcommand{\otSomRubrique}[2]{% titre, couleur
  \par\addvspace{5mm}\needspace{6\baselineskip}\noindent
  {\otSemi\fontsize{7.2}{9}\selectfont\color{#2}\otCaps[12]{#1}}\par
  \vspace{1.2mm}{\color{#2}\hrule height 0.6pt}\vspace{2mm}}
\newcommand{\otSomLigne}[3]{% numéro ou icône, texte, étiquette de renvoi
  \par\noindent\makebox[10mm][l]{#1}%
  \parbox[b]{\dimexpr\linewidth-28mm\relax}{\RaggedRight #2}%
  {\color{otMuted!45}\leaders\hbox to 2.4mm{\hss.\hss}\hfill}%
  \makebox[8mm][r]{\ifcsname r@#3\endcsname{\otMedium\fontsize{9.4}{11}\selectfont\color{otNavy}\pageref{#3}}%
    \else{\otLight\fontsize{7.4}{9}\selectfont\color{otMuted}à paraître}\fi}\par\vspace{1.6mm}}
\newcommand{\otSomUnite}[1]{%
  \otSomLigne{{\otBold\fontsize{12}{13}\selectfont\color{\otPlanP{coul}{\otPartieDe{#1}}}#1}}%
    {{\otSemi\fontsize{10.4}{12.4}\selectfont\enb{\otPlanU{titre}{#1}}}\hspace{2.2mm}%
     {\otRegular\fontsize{9}{12.4}\selectfont\color{otMuted}\otPlanU{sous}{#1}}}{unite-#1}}
% Partie à laquelle appartient une unité
\newcommand{\otPartieDe}[1]{\ifnum#1<5 1\else\ifnum#1<9 2\else\ifnum#1<13 3\else\ifnum#1<17 4\else 5\fi\fi\fi\fi}
\newcommand{\otSomPartie}[1]{%
  \otSomRubrique{Partie #1\enspace·\enspace\otPlanP{titre}{#1}\enspace{\otLight\enb{\otPlanP{en}{#1}}}}{\otPlanP{coul}{#1}}%
  \foreach \u in {\otPlanP{de}{#1},...,\otPlanP{a}{#1}}{\otSomUnite{\u}}%
  \otSomLigne{\otTuile[5mm]{coche}{\otPlanP{coul}{#1}}}%
    {{\otSemi\fontsize{10}{12.4}\selectfont Bilan #1}\hspace{2.2mm}%
     {\otRegular\fontsize{9}{12.4}\selectfont\color{otMuted}révisions et test des unités \otPlanP{de}{#1} à \otPlanP{a}{#1}}}{bilan-#1}}
% Tableau des contenus d'une partie
\newcommand{\otPrgPartie}[1]{%
  \otPrgPrepare{#1}%
  \par\addvspace{4mm}\needspace{6\baselineskip}\noindent
  \begin{tcolorbox}[enhanced,colback=\otPlanP{coul}{#1},colframe=\otPlanP{coul}{#1},arc=1.4mm,left=3mm,right=3mm,
    top=1.8mm,bottom=1.8mm,boxsep=0pt,before skip=0pt,after skip=1.5mm,coltext=white]
  {\otSemi\fontsize{7.4}{9}\selectfont\otCaps[12]{Partie #1}}\hspace{2.5mm}{\otSemi\fontsize{10.5}{12}\selectfont\otPlanP{titre}{#1}}%
  \hspace{2mm}{\otLight\fontsize{9.5}{12}\selectfont\enb{\otPlanP{en}{#1}}}
  \end{tcolorbox}
  \noindent{\renewcommand{\arraystretch}{1.25}\arrayrulecolor{otRule}%
  \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}p{30mm}*{5}{>{\RaggedRight\arraybackslash\fontsize{8.3}{10.2}\selectfont}X}@{}}
  \otTH{Unité} & \otTH{Communication} & \otTH{Grammaire} & \otTH{Vocabulaire} & \otTH{Prononciation} & \otTH{Culture}\\\midrule
  \otPrgCorps
  \end{tabularx}}\par}
% Corps du tableau construit avant la tabularx (pas de conditionnelle autour des &)
\newcommand{\otPrgCorps}{}
\newcommand{\otPrgPrepare}[1]{%
  \gdef\otPrgCorps{}%
  \foreach \u in {\otPlanP{de}{#1},...,\otPlanP{a}{#1}}{%
    \ifnum\u=\otPlanP{a}{#1}\relax
      \xdef\otPrgCorps{\unexpanded\expandafter{\otPrgCorps}\noexpand\otPrgLigne{\u}\noexpand\\\noexpand\bottomrule}%
    \else
      \xdef\otPrgCorps{\unexpanded\expandafter{\otPrgCorps}\noexpand\otPrgLigne{\u}\noexpand\\\noexpand\midrule}%
    \fi}}
\newcommand{\otPrgLigne}[1]{%
  {\otBold\fontsize{11}{12}\selectfont\color{\otPlanP{coul}{\otPartieDe{#1}}}#1}\enspace
  {\otSemi\fontsize{8.6}{10.4}\selectfont\enb{\otPlanU{titre}{#1}}}\par
  {\fontsize{8.2}{10}\selectfont\color{otMuted}\otPlanU{sous}{#1}}
  & \otPlanU{com}{#1} & \otPlanU{gram}{#1} & \otPlanU{voc}{#1} & \otPlanU{pron}{#1} & \otPlanU{cult}{#1}}

%% ---------------------------------------------------------------------
%%  Lexique (écrit par outils/lexique.py)
%% ---------------------------------------------------------------------
\NewDocumentEnvironment{lexique}{}{%
  \noindent{\fontsize{10}{13}\selectfont\color{otMuted}Le chiffre à droite indique l'unité où le mot
  apparaît pour la première fois. Les expressions sont classées à leur premier mot.\par}\vspace{3mm}
  \begin{multicols}{2}\raggedcolumns\setlength{\columnseprule}{0.4pt}\def\columnseprulecolor{\color{otRule}}}
  {\end{multicols}}
\newcommand{\lexlettre}[1]{\par\addvspace{3mm}\needspace{4\baselineskip}\noindent
  {\otBold\fontsize{14}{16}\selectfont\color{otNavy}#1}\hspace{2mm}{\color{otRule}\leaders\hrule height 0.5pt\hfill\kern0pt}\par\vspace{1.4mm}}
\newcommand{\lexmot}[4]{\par\noindent\hangindent=4mm
  \enb{\textbf{#1}}\enspace{\fontsize{9.6}{12}\selectfont\ipa{#2}}\enspace{\fontsize{10}{12.4}\selectfont #3}%
  \hfill{\otSemi\fontsize{7}{9}\selectfont\color{otNavy}#4}\par\vspace{0.9mm}}

% Bulle de dialogue (illustrations) : \otBulle{position}{ancre}{texte}{couleur fond}{couleur texte}{pointe}
\newcommand{\otBulle}[6]{%
  \node[rectangle callout,fill=#4,text=#5,rounded corners=2.2mm,inner xsep=3.2mm,inner ysep=2.2mm,
    callout absolute pointer={#6},font=\otSemi\fontsize{11}{13}\selectfont,anchor=#2] at #1 {\enb{#3}};}

